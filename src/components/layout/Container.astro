---
// src/components/layout/Container.astro
// Sentrert innholdsbeholder med konsistent horisontal padding.
// Respekterer --container-max og --container-padding fra globals.css.
//
// Props:
//   as      — HTML-element å rendre som (default: "div")
//   class   — ekstra klasser

// Eksporteres slik at Astro faktisk bruker typen. Uten export ser
// tsserver den som ubrukt, fordi Astro.props types implisitt.
export interface Props {
  as?:    string;
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = "div",
  class: className = "",
  ...rest
} = Astro.props;
---

<Tag class={`container ${className}`} {...rest}>
  <slot />
</Tag>
