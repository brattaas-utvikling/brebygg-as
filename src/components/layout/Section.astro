---
// src/components/layout/Section.astro

type Variant = "default" | "white" | "section" | "dark" | "dark-2" | "none";

interface Props {
  variant?: Variant;
  id?: string;
  class?: string;
  noPadding?: boolean;
  ariaLabel?: string;
  ariaLabelledby?: string;
}

const {
  variant = "default",
  id,
  class: extra = "",
  noPadding = false,
  ariaLabel,
  ariaLabelledby,
} = Astro.props;

const bgMap: Record<Variant, string> = {
  default: "bg-[var(--color-bg)]",
  white: "bg-[var(--color-bg-white)]",
  section: "bg-[var(--color-bg-section)]",
  dark: "bg-[var(--color-bg-dark)] text-inv",
  "dark-2": "bg-[var(--color-bg-dark-2)] text-inv",
  none: "",
};

const paddingClass = noPadding ? "" : "section";
---

<section
  id={id}
  class={`${paddingClass} ${bgMap[variant]} ${extra}`.trim()}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</section>

