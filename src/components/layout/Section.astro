---
// src/components/layout/Section.astro

type Variant = "default" | "white" | "section" | "dark" | "dark-2" | "none";

interface Props {
  variant?: Variant;
  id?: string;
  class?: string;
  noPadding?: boolean;
  ariaLabel?: string;
  ariaLabelledby?: string;
}

const {
  variant = "default",
  id,
  class: extra = "",
  noPadding = false,
  ariaLabel,
  ariaLabelledby,
} = Astro.props;

// Temaklasser. Navnene speiler `tema`-feltet som kommer i Sanity (fase 7),
// slik at klientens dropdown mapper 1:1 hit uten oversettelseslag.
//
// v1 brukte Tailwind arbitrary values (bg-[var(--color-bg-section)]). De
// forsvant da Tailwind ble fjernet, og seksjonene mistet bakgrunnsfargen sin
// uten at noe feilet — bygget var grønt, siden var flat.
const bgMap: Record<Variant, string> = {
  default:  "sek--lys",
  white:    "sek--hvit",
  section:  "sek--seksjon",
  dark:     "sek--mork",
  "dark-2": "sek--khaki",
  none:     "",
};

const paddingClass = noPadding ? "" : "section";
---

<section
  id={id}
  class={`${paddingClass} ${bgMap[variant]} ${extra}`.trim()}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</section>
