---
// src/components/layout/Header.astro

import { NAP } from "@config/site";
import { MAIN_NAV } from "@config/navigation";

const currentPath = Astro.url.pathname;

function normalizePath(p: string): string {
  return p === "/" ? "/" : p.replace(/\/$/, "");
}

function isActive(href: string): boolean {
  const current = normalizePath(currentPath);
  const target = normalizePath(href);
  if (target === "/") return current === "/";
  return current === target || current.startsWith(target + "/");
}

// Alle punktene rendres likt, Kontakt inkludert. Telefonen er den eneste
// knappen, og den finnes bare på mobil — der den faktisk ringer noen.
const navLinks = MAIN_NAV;
---

<header class="nav" id="site-header">
  <div class="nav__inner">
    {/* Logo */}
    <a
      href="/"
      class="nav__logo"
      aria-label={`${NAP.name} — tilbake til forsiden`}
    >
      {/* alt="" med vilje: <a> har allerede aria-label, og den vinner over
          alt-teksten. To navn på samme lenke leses som støy av skjermleser. */}
      <img
        src="/images/logo-brebygg.webp"
        alt=""
        class="nav__logo-img"
        width="71"
        height="48"
        loading="eager"
        decoding="async"
      />
    </a>

    {/* Hovedlenker. Ligger til høyre nå som telefonkolonnen er borte. */}
    <nav aria-label="Hovednavigasjon" class="nav__center">
      <ul class="nav__links" role="list" id="main-nav-list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }

        {/* Mobilmeny: telefonen som knapp, nederst */}
        <li class="mobile-only-item phone-item">
          <a
            href={`tel:${NAP.phone.replace(/\s/g, "")}`}
            class="btn btn--pa-gronn phone-link"
            aria-label={`Ring oss: ${NAP.phoneDisplay}`}
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M11.9 9.5 10 9.3c-.5-.06-.98.1-1.3.42L7.36 11.05C5.3 10.03 3.6 8.33 2.58 6.27L3.9 4.93c.32-.32.48-.78.42-1.3L2.14.44A1.35 1.35 0 0 0 .8-.47H-.47C-1.3-.47-1.93.16-1.87 1c.4 6.5 5.5 11.6 12 12a1.35 1.35 0 0 0 1.47-1.34v-1.34a1.35 1.35 0 0 0-1.7-1.82Z"
                fill="currentColor"></path>
            </svg>
            {NAP.phoneDisplay}
          </a>
        </li>
      </ul>
    </nav>

    {/* Hamburger */}
    <button
      class="nav-burger"
      aria-label="Åpne meny"
      aria-expanded="false"
      aria-controls="main-nav-list"
      type="button"
    >
      <span class="nav-burger__bar bar-top" aria-hidden="true"></span>
      <span class="nav-burger__bar bar-middle" aria-hidden="true"></span>
      <span class="nav-burger__bar bar-bottom" aria-hidden="true"></span>
    </button>
  </div>
</header>

{
  /* ─────────────────────────────────────────────────────────────────────
     SCROLL-HIDE (portert fra KIL-prosjektet)
     Mobil: header glir opp ved scroll ned, dukker opp ved scroll opp.
     Desktop: alltid synlig.
     Bruker requestAnimationFrame + ticking for å unngå scroll-jank.
     ───────────────────────────────────────────────────────────────── */
}
<script>
  (function () {
    const header = document.getElementById("site-header");
    if (!header) return;

    let lastY = 0;
    let ticking = false;

    window.addEventListener(
      "scroll",
      function () {
        if (!ticking) {
          requestAnimationFrame(function () {
            var currentY = window.scrollY;
            var isMobile = window.innerWidth < 768;

            if (isMobile && currentY > lastY && currentY > 100) {
              // Scroll ned på mobil + forbi terskel → skjul
              header.style.transform = "translateY(-100%)";
            } else {
              // Scroll opp, eller desktop → vis
              header.style.transform = "translateY(0)";
            }

            lastY = currentY;
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  })();
</script>

<style>
  /* ── Logo ─────────────────────────────────────────────────────────── */
  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    max-width: clamp(120px, 30vw, 240px);
    border-radius: var(--r-sm);
    /* Mørk fokusring: headeren er Green Leaf, ikke lenger mørk. */
    outline-offset: 4px;
  }

  .nav__logo:focus-visible {
    outline: 2px solid var(--color-text-on-green);
  }

  /* Logo-bilde: smooth scale på hover (fra KIL) */
  .nav__logo-img {
    height: clamp(40px, 4vw, 72px);
    width: auto;
    max-width: none;
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.2s ease;
  }

  .nav__logo:hover .nav__logo-img {
    transform: scale(1.05);
    opacity: 0.92;
  }

  /* ── Mobilmeny-ekstraelementer ───────────────────────────────────── */
  .mobile-only-item {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-only-item {
      display: list-item;
    }

    /* Panelet har samme Green Leaf som headeren, så lenkene arver riktig
       tekstfarge fra globals.css uten overstyring her. */

    /* Ingen border-top: li-en over har allerede border-bottom, og de to
       stablet seg til en dobbel hårlinje. Luften gjør skillet. */
    .phone-item {
      border-bottom: none;
      padding-top: 1.25rem;
    }

    /* Telefonen er eneste knapp i menyen. bandicoot-950 og ikke rust:
       rust er 1,70:1 mot Green Leaf og ville ikke hatt synlig grense.

       Selektoren må være .nav__links .phone-link og ikke bare .phone-link:
       .nav__links a i globals.css er 0-1-1 og slår .btn--pa-gronn på 0-1-0,
       så knappeteksten arvet bandicoot-950 og ble svart på svart. */
    .nav__links .phone-link {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.875rem 1.5rem;
      color: var(--color-text-inv);
      font-size: 0.9375rem;
      font-weight: 600;
    }
    .nav__links .phone-link:hover {
      color: var(--color-text-inv);
      opacity: 1;
    }
    /* Understreken hører til tekstlenkene, ikke til knappen. */
    .nav__links .phone-link::after {
      display: none;
    }
    .phone-link svg {
      flex-shrink: 0;
    }
  }

  /* ── Burger → ✕ (smooth, 280ms) ─────────────────────────────────── */
  .nav-burger__bar {
    display: block;
    transform-origin: center center;
    transition:
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-burger:focus-visible {
    outline: 2px solid var(--color-text-on-green);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  /* :has()-variant */
  :global(#site-header:has(#main-nav-list.is-open) .bar-top) {
    transform: translateY(7px) rotate(45deg);
  }
  :global(#site-header:has(#main-nav-list.is-open) .bar-middle) {
    opacity: 0;
    transform: scaleX(0);
  }
  :global(#site-header:has(#main-nav-list.is-open) .bar-bottom) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* aria-expanded fallback */
  :global(.nav-burger[aria-expanded="true"] .bar-top) {
    transform: translateY(7px) rotate(45deg);
  }
  :global(.nav-burger[aria-expanded="true"] .bar-middle) {
    opacity: 0;
    transform: scaleX(0);
  }
  :global(.nav-burger[aria-expanded="true"] .bar-bottom) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Aktiv lenke. Var --color-text-inv (hvit) fra den mørke headeren — det ga
     1,3:1 mot Green Leaf. !important var heller ikke nødvendig: :global()
     legger til astro-cid-attributtet, som gir høyere spesifisitet enn regelen
     i globals.css uansett. */
  :global(.nav__links a[aria-current="page"]) {
    color: var(--color-text-on-green);
    font-weight: 600;
  }
</style>

<script>
  // Mobilmeny. Flyttet hit fra BaseLayout, der den lastet på alle sider
  // uavhengig av om Header var med i treet.
  const burger = document.querySelector<HTMLElement>(".nav-burger");
  const links = document.querySelector<HTMLElement>(".nav__links");
  const nav = document.querySelector<HTMLElement>(".nav");

  if (burger && links) {
    const lukk = () => {
      links.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };
    const apne = () => {
      links.classList.add("is-open");
      burger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    burger.addEventListener("click", () => {
      links.classList.contains("is-open") ? lukk() : apne();
    });

    links
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", lukk));

    document.addEventListener("click", (e) => {
      if (nav && !nav.contains(e.target as Node)) lukk();
    });

    document.addEventListener("keydown", (e) => {
      if (!links.classList.contains("is-open")) return;

      if (e.key === "Escape") {
        lukk();
        burger.focus(); // fokus tilbake til utløseren, ikke ut i intet
        return;
      }

      // Fokusfelle. Menyen dekker skjermen, men innholdet bak den ligger
      // fortsatt i taborden — uten dette tabber man rett forbi menyen og ned
      // i en side man ikke ser. Hamburgeren er med i syklusen, slik at Tab
      // alltid kan nå knappen som lukker menyen.
      if (e.key !== "Tab") return;

      const fokuserbare = [
        burger,
        ...links.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      ].filter((el) => el.offsetParent !== null || el === burger);

      const forste = fokuserbare[0];
      const siste = fokuserbare[fokuserbare.length - 1];
      if (!forste || !siste) return;

      const aktiv = document.activeElement;

      if (e.shiftKey && aktiv === forste) {
        e.preventDefault();
        siste.focus();
      } else if (!e.shiftKey && aktiv === siste) {
        e.preventDefault();
        forste.focus();
      }
    });
  }
</script>
