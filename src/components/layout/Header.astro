---
// src/components/layout/Header.astro

import { NAP } from "@config/site";
import { MAIN_NAV } from "@config/navigation";

const currentPath = Astro.url.pathname;

function normalizePath(p: string): string {
  return p === "/" ? "/" : p.replace(/\/$/, "");
}

function isActive(href: string): boolean {
  const current = normalizePath(currentPath);
  const target = normalizePath(href);
  if (target === "/") return current === "/";
  return current === target || current.startsWith(target + "/");
}

const navLinks = MAIN_NAV.filter((item) => !item.cta);
const ctaItem = MAIN_NAV.find((item) => item.cta);
---

<header class="nav" role="banner" id="site-header">
  <div class="nav__inner">
    {/* Logo */}
    <a
      href="/"
      class="nav__logo"
      aria-label={`${NAP.name} — tilbake til forsiden`}
    >
      <img
        src="/favicon.svg"
        alt={NAP.name}
        class="nav__logo-img"
        width="120"
        height="48"
        loading="eager"
        decoding="async"
      />
    </a>

    {/* Senterlenker */}
    <nav aria-label="Hovednavigasjon" class="nav__center">
      <ul class="nav__links" role="list" id="main-nav-list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }

        {/* Mobilmeny: telefon */}
        <li class="mobile-only-item phone-item">
          <a
            href={`tel:${NAP.phone.replace(/\s/g, "")}`}
            class="phone-link"
            aria-label={`Ring oss: ${NAP.phoneDisplay}`}
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M11.9 9.5 10 9.3c-.5-.06-.98.1-1.3.42L7.36 11.05C5.3 10.03 3.6 8.33 2.58 6.27L3.9 4.93c.32-.32.48-.78.42-1.3L2.14.44A1.35 1.35 0 0 0 .8-.47H-.47C-1.3-.47-1.93.16-1.87 1c.4 6.5 5.5 11.6 12 12a1.35 1.35 0 0 0 1.47-1.34v-1.34a1.35 1.35 0 0 0-1.7-1.82Z"
                fill="currentColor"></path>
            </svg>
            {NAP.phoneDisplay}
          </a>
        </li>

        {/* Mobilmeny: CTA */}
        {
          ctaItem && (
            <li class="mobile-only-item cta-item">
              <a href={ctaItem.href} class="btn btn--primary mobile-cta">
                {ctaItem.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    {/* Desktop høyre: telefon + CTA */}
    <div class="nav__right">
      <a
        href={`tel:${NAP.phone.replace(/\s/g, "")}`}
        class="nav__phone"
        aria-label={`Ring oss: ${NAP.phoneDisplay}`}
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 13 13"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M11 8.8 9.2 8.6c-.45-.05-.9.1-1.2.4L6.65 10.3C4.72 9.34 3.14 7.76 2.18 5.83L3.5 4.5c.3-.3.45-.74.4-1.19L3.72 1.2A1.25 1.25 0 0 0 2.48.1H1.27A1.27 1.27 0 0 0 0 1.38C.38 7.32 5.18 12.12 11.12 12.5a1.27 1.27 0 0 0 1.38-1.27v-1.2A1.27 1.27 0 0 0 11 8.8Z"
            fill="currentColor"></path>
        </svg>
        {NAP.phoneDisplay}
      </a>

      {
        ctaItem && (
          <a href={ctaItem.href} class="btn btn--primary nav__cta">
            {ctaItem.label}
          </a>
        )
      }
    </div>

    {/* Hamburger */}
    <button
      class="nav-burger"
      aria-label="Åpne meny"
      aria-expanded="false"
      aria-controls="main-nav-list"
      type="button"
    >
      <span class="nav-burger__bar bar-top" aria-hidden="true"></span>
      <span class="nav-burger__bar bar-middle" aria-hidden="true"></span>
      <span class="nav-burger__bar bar-bottom" aria-hidden="true"></span>
    </button>
  </div>
</header>

{/* ─────────────────────────────────────────────────────────────────────
     SCROLL-HIDE (portert fra KIL-prosjektet)
     Mobil: header glir opp ved scroll ned, dukker opp ved scroll opp.
     Desktop: alltid synlig.
     Bruker requestAnimationFrame + ticking for å unngå scroll-jank.
     ───────────────────────────────────────────────────────────────── */}
<script>
  (function () {
    const header = document.getElementById("site-header");
    if (!header) return;

    let lastY = 0;
    let ticking = false;

    window.addEventListener(
      "scroll",
      function () {
        if (!ticking) {
          requestAnimationFrame(function () {
            var currentY = window.scrollY;
            var isMobile = window.innerWidth < 768;

            if (isMobile && currentY > lastY && currentY > 100) {
              // Scroll ned på mobil + forbi terskel → skjul
              header.style.transform = "translateY(-100%)";
            } else {
              // Scroll opp, eller desktop → vis
              header.style.transform = "translateY(0)";
            }

            lastY = currentY;
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  })();
</script>

<style>
  /* ── Logo ─────────────────────────────────────────────────────────── */
  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    max-width: clamp(120px, 30vw, 240px);
    border-radius: var(--r-sm);
    /* Focus-ring (KIL-mønster: hvit ring på mørk bakgrunn) */
    outline-offset: 4px;
  }

  .nav__logo:focus-visible {
    outline: 2px solid rgba(245, 243, 239, 0.6);
  }

  /* Logo-bilde: smooth scale på hover (fra KIL) */
  .nav__logo-img {
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.2s ease;
  }

  .nav__logo:hover .nav__logo-img {
    transform: scale(1.05);
    opacity: 0.92;
  }

  /* ── Desktop høyre ────────────────────────────────────────────────── */
  .nav__right {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-shrink: 0;
  }

  .nav__phone {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(245, 243, 239, 0.6);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
    border-radius: var(--r-sm);
    padding: 0.25rem 0.375rem;
  }
  .nav__phone svg {
    flex-shrink: 0;
  }
  .nav__phone:hover {
    color: var(--color-text-inv);
  }

  .nav__phone:focus-visible {
    outline: 2px solid rgba(245, 243, 239, 0.6);
    outline-offset: 3px;
  }

  /* CTA-knapp i nav */
  .nav__cta {
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
  }

  /* ── Mobilmeny-ekstraelementer ───────────────────────────────────── */
  .mobile-only-item {
    display: none;
  }

  @media (max-width: 767px) {
    .nav__right {
      display: none;
    }
    .mobile-only-item {
      display: list-item;
    }

    .phone-item {
      border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
      border-bottom: none !important;
      padding-top: 0.625rem !important;
      margin-top: 0.25rem;
    }

    .cta-item {
      border-bottom: none !important;
      padding-top: 0.25rem;
    }

    .mobile-cta {
      display: block;
      width: 100%;
      text-align: center;
    }

    .phone-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-primary-l) !important;
      font-size: 0.9375rem;
      font-weight: 500;
    }
    .phone-link svg {
      flex-shrink: 0;
    }
  }

  /* ── Burger → ✕ (smooth, 280ms) ─────────────────────────────────── */
  .nav-burger__bar {
    display: block;
    transform-origin: center center;
    transition:
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-burger:focus-visible {
    outline: 2px solid rgba(245, 243, 239, 0.6);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  /* :has()-variant */
  :global(#site-header:has(#main-nav-list.is-open) .bar-top) {
    transform: translateY(7px) rotate(45deg);
  }
  :global(#site-header:has(#main-nav-list.is-open) .bar-middle) {
    opacity: 0;
    transform: scaleX(0);
  }
  :global(#site-header:has(#main-nav-list.is-open) .bar-bottom) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* aria-expanded fallback */
  :global(.nav-burger[aria-expanded="true"] .bar-top) {
    transform: translateY(7px) rotate(45deg);
  }
  :global(.nav-burger[aria-expanded="true"] .bar-middle) {
    opacity: 0;
    transform: scaleX(0);
  }
  :global(.nav-burger[aria-expanded="true"] .bar-bottom) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Aktiv lenke */
  :global(.nav__links a[aria-current="page"]) {
    color: var(--color-text-inv) !important;
    font-weight: 600;
  }
</style>

<script>
  // Mobilmeny. Flyttet hit fra BaseLayout, der den lastet på alle sider
  // uavhengig av om Header var med i treet.
  const burger = document.querySelector<HTMLElement>(".nav-burger");
  const links  = document.querySelector<HTMLElement>(".nav__links");
  const nav    = document.querySelector<HTMLElement>(".nav");

  if (burger && links) {
    const lukk = () => {
      links.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };
    const apne = () => {
      links.classList.add("is-open");
      burger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    burger.addEventListener("click", () => {
      links.classList.contains("is-open") ? lukk() : apne();
    });

    links.querySelectorAll("a").forEach((a) => a.addEventListener("click", lukk));

    document.addEventListener("click", (e) => {
      if (nav && !nav.contains(e.target as Node)) lukk();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && links.classList.contains("is-open")) {
        lukk();
        burger.focus(); // fokus tilbake til utløseren, ikke ut i intet
      }
    });
  }
</script>
