---
// src/components/layout/Footer.astro
// Logo midtstilt øverst, deretter fire kolonner: Kontakt, Tjenester,
// Selskapet og Sosiale medier. Til slutt copyright og org.nr.
//
// NAP er identisk med LocalBusiness-schema og KontaktStrip. SoMe-lenkene
// kommer fra SOME_KANALER, samme kilde som SoMe-blokka og sameAs i JSON-LD.
//
// Stilene står i globals.css (seksjon 14), ikke her: SomeIkon får klassen sin
// som prop, og scoped CSS herfra ville ikke nådd <svg>-en den rendrer.

import { NAP, OPENING_HOURS, SOME_KANALER } from "@config/site";
import { FOOTER_NAV } from "@config/navigation";
import SomeIkon from "@components/ui/SomeIkon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="footer" aria-label="Sidefot">
  <div class="container">
    <div class="footer__topp">
      <a
        href="/"
        class="footer__logo"
        aria-label={`${NAP.name} — tilbake til forsiden`}
      >
        {
          /* alt="" — <a> har allerede aria-label, og den vinner over alt-teksten. */
        }
        <img
          src="/images/logo-brebygg.webp"
          alt=""
          class="footer__logo-img"
          width="300"
          height="203"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="footer__grid">
      {/* Kontakt */}
      <div class="footer__kol">
        <p class="footer__heading">Kontakt</p>
        {
          /* <address> er kursiv som standard i nettleseren. Før v2 nullstilte
            Tailwind-klassen not-italic det; den forsvant med Tailwind, og
            teksten ble kursiv uten at noe feilet. .footer__kontakt tar det nå. */
        }
        <address class="footer__kontakt">
          <ul class="footer__liste" role="list">
            <li class="footer__rad">
              <svg
                width="16"
                height="16"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 1C4.79 1 3 2.79 3 5C3 8.5 7 13 7 13C7 13 11 8.5 11 5C11 2.79 9.21 1 7 1ZM7 6.5C6.17 6.5 5.5 5.83 5.5 5C5.5 4.17 6.17 3.5 7 3.5C7.83 3.5 8.5 4.17 8.5 5C8.5 5.83 7.83 6.5 7 6.5Z"
                  fill="currentColor"></path>
              </svg>
              <span itemscope itemtype="https://schema.org/PostalAddress">
                <span itemprop="streetAddress">{NAP.address.street}</span><br />
                <span itemprop="postalCode">{NAP.address.postalCode}</span>{" "}
                <span itemprop="addressLocality">{NAP.address.city}</span>
              </span>
            </li>

            <li class="footer__rad">
              <svg
                width="16"
                height="16"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M11.55 9.07L9.68 8.86C9.22 8.81 8.77 8.97 8.46 9.28L7.14 10.6C5.16 9.6 3.53 7.98 2.53 5.99L3.86 4.67C4.17 4.36 4.33 3.91 4.28 3.45L4.07 1.59C3.98 0.84 3.35 0.28 2.6 0.28H1.35C0.52 0.28 -0.1 0.9 -0.05 1.73C0.33 7.97 5.29 12.93 11.52 13.31C12.35 13.36 12.97 12.74 12.97 11.91V10.66C12.98 9.91 12.42 9.28 11.55 9.07Z"
                  fill="currentColor"></path>
              </svg>
              <a
                href={`tel:${NAP.phone.replace(/\s/g, "")}`}
                class="footer__lenke"
              >
                {NAP.phoneDisplay}
              </a>
            </li>

            <li class="footer__rad">
              <svg
                width="16"
                height="16"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12.33 1.75H1.67C0.93 1.75 0.34 2.35 0.34 3.08L0.33 10.92C0.33 11.65 0.93 12.25 1.67 12.25H12.33C13.07 12.25 13.67 11.65 13.67 10.92V3.08C13.67 2.35 13.07 1.75 12.33 1.75ZM12.33 4.42L7 7.67L1.67 4.42V3.08L7 6.33L12.33 3.08V4.42Z"
                  fill="currentColor"></path>
              </svg>
              <a href={`mailto:${NAP.email}`} class="footer__lenke"
                >{NAP.email}</a
              >
            </li>

            <li class="footer__rad">
              <svg
                width="16"
                height="16"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 0.33C3.32 0.33 0.33 3.32 0.33 7C0.33 10.68 3.32 13.67 7 13.67C10.68 13.67 13.67 10.68 13.67 7C13.67 3.32 10.68 0.33 7 0.33ZM7.67 10.33H6.33V6.33H7.67V10.33ZM7.67 5H6.33V3.67H7.67V5Z"
                  fill="currentColor"></path>
              </svg>
              <span>{OPENING_HOURS.display}</span>
            </li>
          </ul>
        </address>
      </div>

      {/* Tjenester og Selskapet */}
      {
        FOOTER_NAV.map((group) => (
          <nav class="footer__kol" aria-label={group.heading}>
            <p class="footer__heading">{group.heading}</p>
            <ul class="footer__liste" role="list">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer__lenke"
                    {...(item.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      {/* Sosiale medier */}
      <nav class="footer__kol" aria-label="Sosiale medier">
        <p class="footer__heading">Sosiale medier</p>
        <ul class="footer__liste" role="list">
          {
            SOME_KANALER.map((k) => (
              <li>
                <a
                  href={k.url}
                  class="footer__lenke"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <SomeIkon kanal={k.id} class="footer__ikon" />
                  {k.navn}
                  <span class="footer__sr">(åpnes i ny fane)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <span>&copy; {currentYear} {NAP.name}. Alle rettigheter forbeholdt.</span>
      <span>Organisasjonsnummer: {NAP.orgNumber}</span>
    </div>
  </div>
</footer>
