---
// src/components/sections/HeroPage.astro
// Gjenbrukbar hero-seksjon for innersider (om-oss, prosjekter).
//
// Layout:
//   Venstre (55 %): eyebrow + H1 + ingress + valgfritt sitat + stats
//   Høyre  (45 %): bilde i avrundet ramme
//   Bakgrunn: Charcoal Blue (var(--color-bg-dark))
//
// Props:
//   eyebrow   — tekst over H1
//   heading   — H1-tekst (støtter HTML via set:html for linjeskift)
//   lead      — ingress (maks 2 setninger, konkret)
//   sitat?    — sitattekst
//   sitatKilde? — hvem siterte
//   imgSrc    — sti til bilde (/public/images/…)
//   imgAlt    — alt-tekst
//   stats?    — valgfri array av { num, label }
//   breadcrumb? — vises øverst om satt

interface Stat {
  num: string;
  label: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  sitat?: string;
  sitatKilde?: string;
  imgSrc: string;
  imgAlt: string;
  imgWidth?: number;
  imgHeight?: number;
  stats?: Stat[];
  imgFade?: boolean;
  /**
   * Bakgrunnen til seksjonen rett under. Bølgen fylles med denne fargen.
   *
   * Bølgen var hardkodet til var(--color-bg) (#f5f3ef), mens seksjonen under
   * på /om-oss/ og /kontakt/ er var(--color-bg-white) (#ffffff). Kurven ble
   * dermed en synlig off-white flate mot en hvit seksjon.
   *
   * Verdiene er de samme fem som sek--*-klassene og som `tema`-feltet i Sanity,
   * så når klienten bytter tema på seksjonen under (fase 7), følger bølgen med.
   */
  nesteTema?: "lys" | "hvit" | "seksjon" | "mork" | "khaki";
}

const TEMA_BAKGRUNN = {
  lys:     "var(--color-bg)",
  hvit:    "var(--color-bg-white)",
  seksjon: "var(--color-bg-section)",
  mork:    "var(--color-bg-dark)",
  khaki:   "var(--color-bg-dark-2)",
} as const;

const {
  eyebrow,
  heading,
  lead,
  sitat,
  sitatKilde,
  imgSrc,
  imgAlt,
  imgWidth = 800,
  imgHeight = 960,
  stats = [],
  imgFade = false,
  nesteTema = "lys",
} = Astro.props;
---

<section class="page-hero" aria-label={heading}>
  <div
    class={`container page-hero__inner ${imgFade ? "page-hero__inner--wide" : ""}`}
  >
    {/* Venstre: tekst */}
    <div class="page-hero__text">
      <span class="eyebrow eyebrow--inv">{eyebrow}</span>

      <h1 class="page-hero__heading" set:html={heading} />

      <div class="page-hero__divider" aria-hidden="true"></div>

      <p class="page-hero__lead">{lead}</p>

      {/* Sitat (valgfritt) */}
      {
        sitat && (
          <blockquote class="page-hero__sitat">
            <p class="page-hero__sitat-tekst">{sitat}</p>
            {sitatKilde && (
              <cite class="page-hero__sitat-kilde">— {sitatKilde}</cite>
            )}
          </blockquote>
        )
      }

      {/* Stats (valgfri rad) */}
      {
        stats.length > 0 && (
          <div class="page-hero__stats" role="list" aria-label="Nøkkeltall">
            {stats.map((stat) => (
              <div class="page-hero__stat" role="listitem">
                <div class="page-hero__stat-num">{stat.num}</div>
                <div class="page-hero__stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>

    {/* Høyre: bilde */}
    <div class="page-hero__img-col" aria-hidden="false">
      <div
        class={`page-hero__img-wrap ${imgFade ? "page-hero__img-wrap--fade" : ""}`}
      >
        <img
          src={imgSrc}
          alt={imgAlt}
          width={imgWidth}
          height={imgHeight}
          fetchpriority="high"
          decoding="async"
        />
        {/* Subtil Dusty Olive-ramme øverst til venstre — gir dybde */}
        <div class="page-hero__img-frame" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  {/* Bølge-overgang til neste seksjon */}
  <div class="page-hero__wave" aria-hidden="true">
    <svg
      viewBox="0 0 1440 56"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 56 C360 0 1080 0 1440 56 L1440 56 L0 56 Z"
        fill={TEMA_BAKGRUNN[nesteTema]}></path>
    </svg>
  </div>
</section>

<style>
  /* ── Seksjonsramme ─────────────────────────────────────────────────── */
  .page-hero {
    background-color: var(--color-bg-dark);
    position: relative;
    overflow: hidden;
    /* Padding-top: nav-høyde + rom */
    padding-top: calc(var(--nav-height) + clamp(3rem, 6vw, 5rem));
    /* Padding-bottom: rom til bølgen */
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* Subtil radial-glød bak teksten */
  .page-hero::before {
    content: "";
    position: absolute;
    top: -20%;
    left: -5%;
    width: 55%;
    height: 140%;
    background: radial-gradient(
      ellipse at 30% 40%,
      rgba(132, 133, 110, 0.09) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* ── Split-grid ────────────────────────────────────────────────────── */
  .page-hero__inner {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: clamp(3rem, 5vw, 6rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 1023px) {
    .page-hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  /* Mobil-override for --wide variant */
  @media (max-width: 1023px) {
    .page-hero__inner--wide {
      grid-template-columns: 1fr;
    }
  }

  /* Skjul bilde på mobil — tekst er prioriteten */
  @media (max-width: 767px) {
    .page-hero__img-col {
      display: none;
    }
  }

  /* ── Tekstkolonne ─────────────────────────────────────────────────── */
  .page-hero__heading {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text-inv);
    margin-top: 0.875rem;
    margin-bottom: 0;
    opacity: 0;
    animation: hero-fade-up 0.75s var(--ease-out) 0.2s forwards;
  }

  .page-hero__divider {
    width: 40px;
    height: 3px;
    background-color: var(--color-primary);
    border-radius: 9999px;
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: hero-fade-up 0.75s var(--ease-out) 0.25s forwards;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.8vw, 1.175rem);
    line-height: 1.7;
    color: var(--color-text-inv-m);
    max-width: 520px;
    margin: 0;
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.35s forwards;
  }

  /* ── Sitat ─────────────────────────────────────────────────────────── */
  .page-hero__sitat {
    margin: 1.75rem 0 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background-color: rgba(132, 133, 110, 0.08);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.48s forwards;
  }

  .page-hero__sitat-tekst {
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text-inv);
    max-width: none;
    margin: 0 0 0.5rem;
  }

  .page-hero__sitat-kilde {
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 600;
    color: var(--color-primary-l);
    letter-spacing: 0.02em;
    display: block;
  }

  /* ── Stats-rad ─────────────────────────────────────────────────────── */
  .page-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(245, 243, 239, 0.1);
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.6s forwards;
  }

  .page-hero__stat {
    position: relative;
  }

  .page-hero__stat + .page-hero__stat::before {
    content: "";
    position: absolute;
    left: calc(-1 * clamp(0.75rem, 1.5vw, 1.25rem));
    top: 10%;
    height: 80%;
    width: 1px;
    background: rgba(245, 243, 239, 0.12);
  }

  @media (max-width: 479px) {
    .page-hero__stat + .page-hero__stat::before {
      display: none;
    }
  }

  .page-hero__stat-num {
    font-family: var(--ff-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text-inv);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .page-hero__stat-label {
    font-size: 0.8rem;
    color: var(--color-text-inv-m);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  /* ── Bildekolonne ─────────────────────────────────────────────────── */
  .page-hero__img-col {
    position: relative;
    /* Skjules på mobil — tekst prioriteres */
  }

  @media (max-width: 1023px) {
    .page-hero__img-col {
      /* På tablet: kortere versjon */
      max-height: 380px;
      overflow: hidden;
      border-radius: var(--r-xl);
    }
  }

  .page-hero__img-wrap {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    /* Portrettformat på desktop */
    aspect-ratio: 5 / 6;
    box-shadow: var(--shadow-xl);
    /* Animasjon inn fra høyre */
    opacity: 0;
    transform: translateX(24px);
    animation: img-slide-in 0.8s var(--ease-out) 0.3s forwards;
  }

  /* @media (max-width: 1023px) {
    .page-hero__img-wrap {
      aspect-ratio: 16 / 9;
    }
  } */

  @keyframes img-slide-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .page-hero__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Dusty Olive-ramme — posisjonert bak bildet */
  .page-hero__img-frame {
    position: absolute;
    inset: -10px -10px 10px 10px;
    border: 2px solid rgba(132, 133, 110, 0.25);
    border-radius: calc(var(--r-xl) + 2px);
    z-index: -1;
    pointer-events: none;
  }

  /* ── Bølge-overgang ─────────────────────────────────────────────── */
  .page-hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    line-height: 0;
    z-index: 2;
  }

  .page-hero__wave svg {
    width: 100%;
    height: clamp(28px, 4vw, 56px);
    display: block;
  }

  /* Bredt bilde-variant (imgFade) — kun desktop */
  @media (min-width: 1024px) {
    .page-hero__inner--wide {
      grid-template-columns: 40fr 60fr;
    }
  }

  .page-hero__img-wrap--fade {
    border-radius: 0 var(--r-xl) var(--r-xl) 0;
  }

  .page-hero__img-wrap--fade::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      var(--color-bg-dark) 0%,
      rgba(44, 66, 81, 0.5) 30%,
      transparent 60%
    );
    pointer-events: none;
  }
</style>
