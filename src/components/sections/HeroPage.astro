---
// src/components/sections/HeroPage.astro
// Gjenbrukbar hero-seksjon for innersider (om-oss, prosjekter).
//
// Layout:
//   Høyre  (45 %): bilde i avrundet ramme
//   Bakgrunn: bandicoot-600 (var(--color-bg-dark))
//
// Props:
//   heading   — H1-tekst. Ren tekst: den kommer fra Sanity og skal ikke tolkes
//               som HTML. Linjebrytingen styres av text-wrap: balance.
//   lead      — ingress (maks 2 setninger, konkret)
//   sitat?    — sitattekst
//   sitatKilde? — hvem siterte
//   bilde     — Sanity-bilde eller lokal fil ({ src, alt, width, height })
//   stats?    — valgfri array av { num, label }

import Bilde from "@components/sanity/Bilde.astro";
import type { Bilde as BildeType } from "@/content.config";
import { SIDEHERO_SIZES } from "@lib/sanity/sider";

interface Stat {
  num: string;
  label: string;
}

interface Props {
  heading: string;
  lead: string;
  sitat?: string | null;
  sitatKilde?: string | null;
  bilde?: BildeType | null;
  stats?: Stat[];
  /**
   * Bakgrunnen til seksjonen rett under. Bølgen fylles med denne fargen.
   *
   * Bølgen var hardkodet til var(--color-bg) (#f5f3ef), mens seksjonen under
   * på /om-oss/ og /kontakt/ er var(--color-bg-white) (#ffffff). Kurven ble
   * dermed en synlig off-white flate mot en hvit seksjon.
   *
   * Verdiene er de samme fem som sek--*-klassene og som `tema`-feltet i Sanity,
   * så når klienten bytter tema på seksjonen under (fase 7), følger bølgen med.
   */
  nesteTema?: "lys" | "hvit" | "seksjon" | "mork" | "khaki";
}

const TEMA_BAKGRUNN = {
  lys: "var(--color-bg)",
  hvit: "var(--color-bg-white)",
  seksjon: "var(--color-bg-section)",
  mork: "var(--color-bg-dark)",
  khaki: "var(--color-bg-dark-2)",
} as const;

const {
  heading,
  lead,
  sitat,
  sitatKilde,
  bilde,
  stats = [],
  nesteTema = "lys",
} = Astro.props;
---

<section class="page-hero" aria-label={heading}>
  <div
    class="container page-hero__inner"
  >
    {/* Venstre: tekst */}
    <div class="page-hero__text">
      <h1 class="page-hero__heading">{heading}</h1>

      <div class="page-hero__divider" aria-hidden="true"></div>

      <p class="page-hero__lead">{lead}</p>

      {/* Sitat (valgfritt) */}
      {
        sitat && (
          <blockquote class="page-hero__sitat">
            <p class="page-hero__sitat-tekst">{sitat}</p>
            {sitatKilde && (
              <cite class="page-hero__sitat-kilde">— {sitatKilde}</cite>
            )}
          </blockquote>
        )
      }

      {/* Stats (valgfri rad) */}
      {
        stats.length > 0 && (
          <div class="page-hero__stats" role="list" aria-label="Nøkkeltall">
            {stats.map((stat) => (
              <div class="page-hero__stat" role="listitem">
                <div class="page-hero__stat-num">{stat.num}</div>
                <div class="page-hero__stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>

    {/* Høyre: bilde */}
    {bilde && <div class="page-hero__img-col">
      <div
        class="page-hero__img-wrap"
      >
        <Bilde kilde={bilde} prioritet fyll sizes={SIDEHERO_SIZES} bredde={800} hoyde={960} />
        {/* Subtil kobberramme øverst til venstre — gir dybde */}
        <div class="page-hero__img-frame" aria-hidden="true"></div>
      </div>
    </div>}
  </div>

  {/* Bølge-overgang til neste seksjon */}
  <div class="page-hero__wave" aria-hidden="true">
    <svg
      viewBox="0 0 1440 56"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 56 C360 0 1080 0 1440 56 L1440 56 L0 56 Z"
        fill={TEMA_BAKGRUNN[nesteTema]}></path>
    </svg>
  </div>
</section>

<style>
  /* ── Seksjonsramme ─────────────────────────────────────────────────── */
  .page-hero {
    background-color: var(--color-bg-dark);
    min-height: var(--hero-min);
    /* -1px: heroens underkant lander på en brøkdels CSS-piksel (målt til
       735,390625 på 375x812), og på DPR 2 antialiaseres den siste raden mot
       seksjonen under — en hårstrek på tvers av hele bredden. Bølgen dekker
       den ikke: kurven starter på y=56 ytterst til venstre og høyre, så der
       er det hvite feltet null høyt og det olivne går helt ned.

       bottom: -1px på selve bølgen løser bare heltallsavrunding. Her må de to
       flatene faktisk overlappe, slik at den hvite seksjonen males over
       heroens siste rad. Bølgen har z-index: 2 og blir liggende øverst. */
    margin-bottom: -1px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    /* Ikke nav-høyde i padding-top lenger: headeren er sticky og ligger
       over heroen, ikke oppå. Kompensasjonen ga ~70 px tom flate øverst. */
    padding-top: clamp(2.5rem, 5vw, 4rem);
    /* Padding-bottom: rom til bølgen (maks 56 px) */
    padding-bottom: clamp(3.5rem, 6vw, 4.5rem);
  }

  /* Felles høyde med de andre undersidenes heroer — se --hero-hoyde. */
  @media (min-width: 1024px) {
    .page-hero {
      min-height: var(--hero-hoyde);
    }
  }

  /* ── Split-grid ────────────────────────────────────────────────────── */
  .page-hero__inner {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: clamp(3rem, 5vw, 6rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 1023px) {
    .page-hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Skjul bilde på mobil — tekst er prioriteten */
  @media (max-width: 767px) {
    .page-hero__img-col {
      display: none;
    }
  }

  /* ── Tekstkolonne ─────────────────────────────────────────────────── */
  .page-hero__heading {
    text-wrap: balance;
    font-size: var(--hero-tittel);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text-inv);
    margin-top: 0.875rem;
    margin-bottom: 0;
    opacity: 0;
    animation: hero-fade-up 0.75s var(--ease-out) 0.2s forwards;
  }

  .page-hero__divider {
    width: 40px;
    height: 3px;
    background-color: var(--color-signature);
    border-radius: 9999px;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: hero-fade-up 0.75s var(--ease-out) 0.25s forwards;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.8vw, 1.175rem);
    line-height: 1.7;
    color: var(--color-text-inv-m);
    max-width: 520px;
    margin: 0;
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.35s forwards;
  }

  /* ── Sitat ─────────────────────────────────────────────────────────── */
  .page-hero__sitat {
    /* 1,25rem og ikke 1,75rem: med sitat må Om oss få plass innenfor
       --hero-hoyde, som de andre sidene. */
    margin: 1.25rem 0 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-signature);
    /* background-color: rgba(var(--rgb-primary), 0.08); */
    background-color: var(--color-bg-dark-2);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.48s forwards;
  }

  .page-hero__sitat-tekst {
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text-inv);
    max-width: none;
    margin: 0 0 0.5rem;
  }

  .page-hero__sitat-kilde {
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 600;
    color: var(--color-primary-l);
    letter-spacing: 0.02em;
    display: block;
  }

  /* ── Stats-rad ─────────────────────────────────────────────────────── */
  .page-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(var(--rgb-inv), 0.1);
    opacity: 0;
    animation: hero-fade-up 0.7s var(--ease-out) 0.6s forwards;
  }

  .page-hero__stat {
    position: relative;
  }

  .page-hero__stat + .page-hero__stat::before {
    content: "";
    position: absolute;
    left: calc(-1 * clamp(0.75rem, 1.5vw, 1.25rem));
    top: 10%;
    height: 80%;
    width: 1px;
    background: rgba(var(--rgb-inv), 0.12);
  }

  @media (max-width: 479px) {
    .page-hero__stat + .page-hero__stat::before {
      display: none;
    }
  }

  .page-hero__stat-num {
    font-family: var(--ff-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text-inv);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .page-hero__stat-label {
    font-size: 0.8rem;
    color: var(--color-text-inv-m);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  /* ── Bildekolonne ─────────────────────────────────────────────────── */
  .page-hero__img-col {
    position: relative;
    /* Skjules på mobil — tekst prioriteres */
  }

  @media (max-width: 1023px) {
    .page-hero__img-col {
      /* På tablet: kortere versjon */
      max-height: 380px;
      overflow: hidden;
      border-radius: var(--r-xl);
    }
  }

  /* Bildet skal aldri bestemme seksjonshøyden. Med aspect-ratio gjorde det
     det: 5/6 på en bred kolonne ga 849 px på /om-oss/. På desktop har bildet
     derfor fast høyde — heroens høyde minus padding — og beskjæres med
     object-fit. Under 1024 px står det under teksten i liggende format. */
  .page-hero__img-wrap {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    width: 100%;
    margin-inline: auto;
    box-shadow: var(--shadow-xl);
    /* Animasjon inn fra høyre */
    opacity: 0;
    transform: translateX(24px);
    animation: img-slide-in 0.8s var(--ease-out) 0.3s forwards;
  }

  @media (min-width: 1024px) {
    .page-hero__img-wrap {
      aspect-ratio: auto;
      /* 560 − 4rem topp − 4.5rem bunn = 424 px. */
      height: calc(var(--hero-hoyde) - 8.5rem);
    }
  }

  @keyframes img-slide-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* :global — bildet rendres av <Bilde> og får ikke dette scope-attributtet. */
  .page-hero__img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Kobberramme (signatur) — posisjonert bak bildet */
  .page-hero__img-frame {
    position: absolute;
    inset: -10px -10px 10px 10px;
    border: 2px solid rgba(var(--rgb-primary), 0.25);
    border-radius: calc(var(--r-xl) + 2px);
    z-index: -1;
    pointer-events: none;
  }

  /* ── Bølge-overgang ─────────────────────────────────────────────── */
  .page-hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    line-height: 0;
    z-index: 2;
  }

  .page-hero__wave svg {
    width: 100%;
    height: clamp(28px, 4vw, 56px);
    display: block;
  }

</style>
