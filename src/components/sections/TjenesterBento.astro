---
// src/components/sections/TjenesterBento.astro
// Tjeneste-seksjon med bento-grid layout på mørk bakgrunn.
//
// Layout:
//   Størrelsen per kort styres av bentoStorrelse på tjenesten i Sanity.
//
// Beskrivelse og lenke er alltid synlige, også uten mus. Stilene står i
// globals.css (.tjeneste-card__desc, .tjeneste-card__link).
//
// Bildene er herobildet til hver tjeneste i Sanity.

import { getCollection } from "astro:content";
import Bilde from "@components/sanity/Bilde.astro";

// Leser fra tjenester-collection. v1 hadde TJENESTER duplisert i site.ts og
// plukket dem ut med TJENESTER[0]! — posisjonsavhengig og med non-null-
// assertion, altså to måter å knekke på hvis rekkefølgen endret seg.
//
// bentoStorrelse ligger på tjenesten selv, så klienten styrer layouten fra
// innholdet. Samme felt går rett inn i Sanity i fase 5.
const STORRELSE_KLASSE = {
  large: "tjeneste-card--large",
  small: "tjeneste-card--small",
  third: "tjeneste-card--full",
} as const;

// Hvor bredt kortet vises, i takt med kolonnene i .tjeneste-grid (7/5/12 av
// 12, én kolonne under 1024 px). Før gikk bildet rett til originalfila i
// Sanity, uten srcset: 175–190 KiB JPG per kort også på mobil.
const SIZES = {
  large: "(max-width: 1023px) 100vw, min(58vw, 750px)",
  small: "(max-width: 1023px) 100vw, min(42vw, 540px)",
  third: "(max-width: 1280px) 100vw, 1280px",
} as const;

const cards = (await getCollection("tjenester"))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((t) => ({
    id: t.id,
    title: t.data.kortTittel ?? t.data.title,
    description: t.data.description,
    slug: `/tjenester/${t.id}/`,
    bilde: t.data.heroImage,
    cardClass: STORRELSE_KLASSE[t.data.bentoStorrelse],
    sizes: SIZES[t.data.bentoStorrelse],
  }));

/**
 * skjulTopp: når komponenten står inne i en SeksjonsSkall på forsiden, eier
 * skallet overskriften. Uten dette ville tittelen kommet to ganger, og siden
 * ville fått to <h2> som sier det samme.
 */
interface Props {
  skjulTopp?: boolean;
}

const { skjulTopp = false } = Astro.props;
---

<section class="tjeneste-section section" aria-labelledby="tjenester-heading">
  <div>
    {
      /* Seksjonsheader. Skjules når blokken står i en SeksjonsSkall på
        forsiden — der eier skallet overskriften. */
    }
    {
      !skjulTopp && (
        <div class="section-header text-inv reveal">
          <h2 class="section-title mt-3" id="tjenester-heading">
            Alle typer oppdrag,
            <br />
            en ansvarlig.
          </h2>
          <div class="divider" />
          <p class="section-desc">
            Som totalentreprenør håndterer vi hele kjeden — søknader,
            prosjektering, koordinering og byggeledelse. Du trenger kun å
            forholde deg til oss.
          </p>
        </div>
      )
    }

    {/* Bento-grid */}
    {/* Ingen role="list": listitem er ikke lov på <article> (ARIA in HTML),
        og en innpakning ville flyttet kortene ut av rutenettet. */}
    <div class="tjeneste-grid reveal">
      {
        cards.map((card) => (
          <article
            class={`tjeneste-card ${card.cardClass}`}
            aria-label={card.title}
          >
            {/* Bakgrunnsbilde med parallax-hint */}
            <div class="tjeneste-card__img-wrap" aria-hidden="true">
              <Bilde kilde={card.bilde} alt="" sizes={card.sizes} fyll bredde={1200} hoyde={800} />
            </div>

            {/* Kortinnhold. Sløret ligger på selve tekstblokken, se
                .tjeneste-card__body i globals.css. */}
            <div class="tjeneste-card__body slor-tekst">
              <h3 class="tjeneste-card__title">{card.title}</h3>
              <p class="tjeneste-card__desc">{card.description}</p>
              <a
                href={card.slug}
                class="tjeneste-card__link"
                aria-label={`Les mer om ${card.title}`}
              >
                Les mer
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Full-bredd card: liggende format */
  .tjeneste-card--full .tjeneste-card__body {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tjeneste-card--full .tjeneste-card__title {
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
  }

  /* For full-bredde card: desc og link er alltid synlig */
  .tjeneste-card--full .tjeneste-card__desc {
    max-width: 480px;
    max-height: 80px;
    opacity: 0.75;
    margin: 0;
  }

  .tjeneste-card--full:hover .tjeneste-card__desc {
    max-height: 80px;
    opacity: 1;
  }

  .tjeneste-card--full .tjeneste-card__left {
    flex: 1;
    min-width: 200px;
  }

  .tjeneste-card--full .tjeneste-card__right {
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 767px) {
    .tjeneste-card--full .tjeneste-card__body {
      flex-direction: column;
    }
  }
</style>
