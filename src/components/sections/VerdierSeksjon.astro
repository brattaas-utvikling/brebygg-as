---
// src/components/sections/VerdierSeksjon.astro
// Fire verdier — diagonale kort med bilde til venstre og tekst til høyre.
//
// Design:
//   Bildebredde = 38.2 % av kortet (det gylne snitt: 1/φ²)
//   Diagonal clip-path: topp 100% → bunn 84% — ca. 16 % skrå
//   rustlinje langs diagonalkanten
//   Hover: bilde zoomer lett inn
//
// Innhold og bilder kommer fra «Om oss» i Sanity. Standardverdiene (med
// bildene i /public/images/verdier/) ligger i src/lib/sanity/sider.ts.

import Bilde from "@components/sanity/Bilde.astro";
import type { OmOssSide } from "@lib/sanity/sider";

type Props = OmOssSide["verdier"];

const { overskrift, ingress, punkter } = Astro.props;
---

<section class="verdier-seksjon section" aria-labelledby="verdier-heading">
  <div class="container">
    {/* Seksjonsheader */}
    <div class="section-header section-header--center text-inv reveal">
      <h2 class="section-title mt-3" id="verdier-heading">{overskrift}</h2>
      <div class="divider divider--center"></div>
      <p class="section-desc" style="margin-inline: auto;">{ingress}</p>
    </div>

    {/* Kortgrid */}
    <div
      class="vd-grid reveal"
      role="list"
      aria-label="Verdier og arbeidsprinsipper"
    >
      {
        punkter.map((v) => (
          <article class="vd-kort" role="listitem" aria-label={v.tittel}>
            {/* Bilde — klippet med diagonal, gylne snitt-bredde */}
            <div class="vd-bilde" aria-hidden="true">
              <Bilde
                kilde={v.bilde}
                alt=""
                fyll
                bredde={600}
                hoyde={400}
                sizes="(max-width: 768px) 40vw, 300px"
              />
              {/* ruststrek langs diagonalkanten */}
              <div class="vd-diagonal-linje" aria-hidden="true" />
            </div>

            {/* Tekst */}
            <div class="vd-tekst">
              <p class="vd-nr-kategori">
                <span class="vd-kategori">{v.kategori}</span>
              </p>
              <h3 class="vd-tittel">{v.tittel}</h3>
              <p class="vd-body">{v.tekst}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Seksjon ─────────────────────────────────────────────────────── */
  .verdier-seksjon {
    background-color: var(--color-bg-dark);
    position: relative;
    /* clip og ikke hidden: hidden gjør seksjonen til en scroll-container,
       og .reveal inni kobler seg da til en tidslinje som aldri går. */
    overflow: clip;
  }

  /* ── 2×2 kortgrid ────────────────────────────────────────────────── */
  .vd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 767px) {
    .vd-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Enkelt kort ─────────────────────────────────────────────────── */
  .verdier-seksjon {
    /* Nye, navngitte tokens for denne komponenten */
    --vd-kort-bg: var(
      --color-bg-dark-2
    ); /* bandicoot-800 — skiller kortet fra section-bakgrunnen (bandicoot-600) */
    --vd-kort-border: rgba(var(--rgb-inv), 0.07);
    --vd-kort-border-hover: color-mix(
      in srgb,
      var(--color-signature) 40%,
      transparent
    );
    --vd-linje-slutt: color-mix(
      in srgb,
      var(--color-signature) 25%,
      transparent
    );

    background-color: var(--color-bg-dark);
    position: relative;
    /* clip og ikke hidden: hidden gjør seksjonen til en scroll-container,
       og .reveal inni kobler seg da til en tidslinje som aldri går. */
    overflow: clip;
  }

  /* min-height og ikke height: kortet vokser med teksten. Med fast høyde og
     line-clamp ble verditekstene kuttet midt i en setning, og det fantes
     ingen måte å lese resten på. Kortene i samme rad blir like høye av
     rutenettet (stretch). */
  .vd-kort {
    display: flex;
    min-height: clamp(170px, 18vw, 220px);
    border-radius: var(--r-lg);
    overflow: hidden;
    background-color: var(--vd-kort-bg); /* var #243545 */
    border: 1px solid var(--vd-kort-border);
    transition: border-color var(--transition-base);
  }

  .vd-kort:hover {
    border-color: var(
      --vd-kort-border-hover
    ); /* var rgba(var(--rgb-primary), 0.2) */
  }

  /* ── Bildekolonne ────────────────────────────────────────────────── */
  /*
    Gylne snitt: φ = 1.618 → 1/φ² ≈ 38.2 %
    Vi bruker 40% som praktisk avrunding for clip-path-matematikken.
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%)
      → Topp-høyre: 100 % av bildebredden
      → Bunn-høyre: 84 % av bildebredden
      → Skrå på ~16 % (ca. 9° ved 200px høyde)
  */
  .vd-bilde {
    position: relative;
    flex-shrink: 0;
    width: 40%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
    overflow: hidden;
    z-index: 1;
  }

  /* :global — bildet rendres av <Bilde>, som ikke får denne komponentens
     scope-attributt. Uten det traff regelen bare lokale <img>. */
  /* Absolutt: bildet fyller kolonnen uten å bestemme høyden. I flyt satte
     et stående bilde høyden på hele kortet (353 px mot 220 px i raden over),
     nå som kortet har min-height og ikke fast høyde. Teksten bestemmer. */
  .vd-bilde :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Overgang fra bildet inn mot teksten til høyre. Samme system som .slor
     (warm dark, mørkest på tekstsiden), men svakere: teksten står ikke over
     bildet her, så overgangen er bare en myk kant. */
  .vd-bilde::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(var(--rgb-dark-2), 0) 50%,
      rgba(var(--rgb-dark-2), 0.35) 100%
    );
    pointer-events: none;
  }
  /* Strek langs diagonalkanten */
  .vd-diagonal-linje {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2px;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      var(--color-signature),
      var(--vd-linje-slutt)
    );
    transform-origin: top right;
    transform: skewX(-6.5deg) translateX(-1px);
    pointer-events: none;
  }

  /* ── Tekstkolonne ────────────────────────────────────────────────── */
  .vd-tekst {
    flex: 1;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2vw, 1.625rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0; /* Hindrer overflow i flex-child */
  }

  /* Kategori (nummereringen 01–04 er fjernet: verdiene har ingen rekkefølge) */
  .vd-nr-kategori {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    max-width: none;
  }

  .vd-kategori {
    font-size: 0.75rem; /* 12 px. Var 11 px. */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    /* Var 0,4 = 3,52:1. 11px er normal tekst, så kravet er 4,5. */
    color: rgba(var(--rgb-inv), 0.66);
  }

  /* Tittel */
  .vd-tittel {
    font-family: var(--ff-display);
    font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
    font-weight: 700;
    color: var(--color-text-inv);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  /* Brødtekst */
  .vd-body {
    font-size: clamp(0.8rem, 1.2vw, 0.875rem);
    line-height: 1.65;
    color: var(--color-text-inv-m);
    margin: 0;
    max-width: none;
  }

  /* Mobil: mer plass til tekst, så kortene ikke blir unødig høye. */
  @media (max-width: 767px) {
    .vd-bilde {
      width: 38%;
    }
  }
  @media (max-width: 400px) {
    .vd-bilde {
      width: 32%;
    }
  }
</style>
