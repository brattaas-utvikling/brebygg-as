---
// src/components/sections/OmOssTeaser.astro
// Kort presentasjon av BRE Bygg.
// Split-layout: tekst venstre, bilde høyre.
//
// Bilde: /public/images/om-oss-teaser.webp
// Format: portrett eller kvadrat, maks 200 KB.

---

<section
  class="om-oss-teaser section"
  aria-labelledby="om-oss-teaser-heading"
>
  <div class="container">
    <div class="teaser-grid">

      {/* Venstre: tekst */}
      <div class="teaser-text reveal">

        <h2 class="section-title mt-3" id="om-oss-teaser-heading">
          Bygget på anbefalinger
        </h2>
        <div class="divider"></div>

        <p>
          De fleste nye kunder i Tønsberg og Sandefjord finner frem til oss
          fordi noen de kjenner har brukt oss. Vi har holdt på lenge nok til
          at vi ikke trenger å love mer enn vi kan holde.
        </p>

        <p class="mt-4">
          Som totalentreprenør sitter vi med ansvaret hele veien — ikke bare
          for det vi gjør selv, men for alle underentreprenørene vi
          koordinerer. Det er slik vi har jobbet hele veien,
          og det er slik vi fortsetter.
        </p>

        <a
          href="/om-oss/"
          class="btn btn--outline mt-6"
          aria-label="Les mer om BRE Bygg"
        >
          Møt laget
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      {/* Høyre: bilde + faktabokser */}
      <div class="teaser-right reveal-d1">

        {/* Bilde */}
        <div class="teaser-img-wrap">
          <img
            src="/images/om-oss-teaser.webp"
            alt="BRE Bygg-team på byggeplass i Vestfold"
            loading="lazy"
            decoding="async"
            width="640"
            height="480"
          />
          {/* Overlay-etikett på bildet */}
          <div class="teaser-img-badge" aria-hidden="true">
            <span class="badge-dot">Aktiv</span>
            <span>Vestfold</span>
          </div>
        </div>

      </div>

      </div>

    </div>
  </div>
</section>


<style>
  /* ── Grid ──────────────────────────────────────────────────────────── */
  .om-oss-teaser {
    background-color: var(--color-bg-section);
  }

  .teaser-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(3rem, 6vw, 6rem);
    align-items:           center;
  }

  @media (max-width: 767px) {
    .teaser-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ── Tekstkolonne ─────────────────────────────────────────────────── */
  .teaser-text p {
    color:     var(--color-text-m);
    max-width: var(--reading-width);
  }

  .mt-4 { margin-top: 1rem; }
  .mt-6 { margin-top: 1.5rem; }

  /* ── Bildekolonne ─────────────────────────────────────────────────── */
  .teaser-right {
    display:        flex;
    flex-direction: column;
    gap:            1.25rem;
  }

  .teaser-img-wrap {
    position:      relative;
    border-radius: var(--r-lg);
    overflow:      hidden;
    aspect-ratio:  4 / 3;
    box-shadow:    var(--shadow-lg);
  }

  .teaser-img-wrap img {
    width:       100%;
    height:      100%;
    object-fit:  cover;
    transition:  transform 0.6s var(--ease-out);
  }

  .teaser-img-wrap:hover img {
    transform: scale(1.03);
  }

  /* Badge på bildet */
  .teaser-img-badge {
    position:         absolute;
    bottom:           1rem;
    left:             1rem;
    display:          flex;
    align-items:      center;
    gap:              0.5rem;
    padding:          0.375rem 0.75rem;
    background-color: rgba(30, 46, 58, 0.85);
    backdrop-filter:  blur(8px);
    border-radius:    var(--r-full);
    font-size:        0.75rem;
    font-weight:      600;
    color:            var(--color-text-inv);
    letter-spacing:   0.04em;
  }

  /* ── Faktabokser ──────────────────────────────────────────────────── */




</style>
