---
// src/components/sections/KartSeksjon.astro
// Kart for BRE Bygg AS, Nordre Fokserød 21, Sandefjord.
//
// Klikk-for-å-laste-fasade. Tre grunner, ikke én:
//   1. Personvern. Et Google-innhold-iframe setter forespørsler mot Google idet
//      siden lastes. Med fasade skjer det først når brukeren ber om det.
//   2. LCP. Iframen er tung og lå i den kritiske lastebanen på /kontakt/.
//   3. Sammenlignbarhet. Fasaden ser lik ut uansett om vi bruker den nøkkelløse
//      q=-formen eller Embed API senere — bytte av MAPS.embedUrl er hele jobben.
//
// v1 pekte på en oppdiktet pb=-streng med koordinater for Sandefjord sentrum.
// Kartet viste altså feil sted, ~5,5 km unna, uten at noe feilet.

import { NAP, MAPS, ADRESSE_EN_LINJE, OPENING_HOURS } from "@config/site";
---

<section
  class="kart-seksjon reveal"
  aria-labelledby="kart-heading"
>
  <div class="container">

    {/* Header: kort introduksjon + lenke */}
    <div class="kart-header">
      <div class="kart-header__inner">
        <div>
          <span class="eyebrow">Finn oss</span>
          <h2
            class="section-title mt-2"
            id="kart-heading"
          >
            Vi holder til i Sandefjord
          </h2>
        </div>
        <a
          href={MAPS.directUrl}
          class="btn btn--outline btn--sm kart-header__cta"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Åpne adressen i Google Maps (åpnes i ny fane)"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 .58A5.25 5.25 0 0 0 1.75 5.83c0 3.5 5.25 7.58 5.25 7.58s5.25-4.08 5.25-7.58A5.25 5.25 0 0 0 7 .58Zm0 7.13a1.88 1.88 0 1 1 0-3.75 1.88 1.88 0 0 1 0 3.75Z"
              fill="currentColor"/>
          </svg>
          Åpne i kart
        </a>
      </div>
    </div>

    {/* Kartramme */}
    <div class="kart-ramme">

      {/* Fasade. Iframen settes inn først ved klikk. */}
      <div class="kart-fasade" data-kart-fasade>
        <div class="kart-fasade__innhold">
          <p class="kart-fasade__adresse">
            <strong>{NAP.name}</strong><br />
            {ADRESSE_EN_LINJE}<br />
            <span class="kart-fasade__tid">{OPENING_HOURS.display}</span>
          </p>
          <button type="button" class="btn btn--primary btn--sm" data-kart-last>
            Vis kart
          </button>
          <p class="kart-fasade__notis">
            Kartet lastes fra Google. Ingen data sendes før du trykker.
          </p>
        </div>
      </div>

      <template data-kart-mal>
        <iframe
          src={MAPS.embedUrl}
          title={`Kart: ${NAP.name}, ${ADRESSE_EN_LINJE}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </template>
    </div>

    {/* Under kartet: adresse + lenke */}
    <div class="kart-under">
      <address class="kart-adresse" aria-label="Besøksadresse">
        <strong>{NAP.name}</strong>
        {NAP.address.street}, {NAP.address.postalCode} {NAP.address.city}
      </address>
      <a
        href={MAPS.directUrl}
        class="btn btn--outline btn--sm"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Få veibeskrivelse til BRE Bygg i Google Maps"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M12.83 6.42 7.58 1.17a.83.83 0 0 0-1.17 0L1.17 6.42a.83.83 0 0 0 0 1.16l5.25 5.25a.83.83 0 0 0 1.17 0l5.24-5.25a.83.83 0 0 0 0-1.16ZM7.83 9.5V7.83H5.17V6.17h2.66V4.5L9.5 7l-1.67 2.5Z"
            fill="currentColor"/>
        </svg>
        Veibeskrivelse
      </a>
    </div>

  </div>
</section>

<script>
  // Setter inn kart-iframen ved klikk. Ingen forespørsel mot Google før det.
  const knapp  = document.querySelector<HTMLButtonElement>("[data-kart-last]");
  const fasade = document.querySelector<HTMLElement>("[data-kart-fasade]");
  const mal    = document.querySelector<HTMLTemplateElement>("[data-kart-mal]");

  if (knapp && fasade && mal) {
    knapp.addEventListener("click", () => {
      const iframe = mal.content.cloneNode(true) as DocumentFragment;
      fasade.replaceWith(iframe);
      // Flytt fokus til kartet, ellers havner det på <body> etter at knappen
      // brukeren nettopp trykket forsvinner ut av DOM.
      document.querySelector<HTMLIFrameElement>(".kart-ramme iframe")?.focus();
    }, { once: true });
  }
</script>

<style>
  .kart-fasade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    background-color: var(--color-bg-section);
    background-image:
      linear-gradient(var(--color-border-l) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-l) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .kart-fasade__adresse {
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.6;
    max-width: none;
  }

  .kart-fasade__tid {
    color: var(--color-text-m);
    font-size: 0.875rem;
  }

  .kart-fasade__notis {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-m);
    max-width: 28ch;
  }
</style>
