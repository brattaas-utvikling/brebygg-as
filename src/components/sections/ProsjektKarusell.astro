---
// src/components/sections/ProsjektKarusell.astro
// Horisontal karusell med prosjektkort.
//
// Henter fra Astro Content Collection 'prosjekter'.
// Viser maks 8 fremhevede/nyeste prosjekter.
//
// At man kan bla sidelengs skal gå fram uten at man prøver seg fram:
//   - kortene går helt ut til skjermkanten, så et kort alltid er delvis synlig
//   - piler for forrige/neste, deaktivert i hver ende
//   - fremdriftslinje som viser hvor mye som finnes og hvor man er
// Pilene og linjen vises først når JS har sjekket at det faktisk er
// mer å bla i. Uten JS er karusellen fortsatt vanlig horisontal scroll.
//
// Tom tilstand:
//   Hvis ingen prosjekter finnes ennå, vises en placeholder-rad.

import { getCollection, type CollectionEntry } from "astro:content";
import { KATEGORI_LABEL } from "@/content.config";
import Bilde from "@components/sanity/Bilde.astro";

/**
 * skjulTopp: når komponenten står inne i en SeksjonsSkall på forsiden, eier
 * skallet overskriften, bakgrunnen og luften over og under. Da rendres ingen
 * egen <section> her — før ble det to nestede seksjoner med dobbel padding,
 * og den indre lyse bakgrunnen overstyrte temaet klienten valgte i Sanity.
 */
interface Props {
  skjulTopp?: boolean;
  antall?: number;
  kunFremhevede?: boolean;
}

const { skjulTopp = false, antall = 8, kunFremhevede = false } = Astro.props;

// v1 hadde en håndlaget ProsjektEntry-type med { slug, data }. Den skygget for
// CollectionEntry og gjorde at `entry.id` ikke fantes på typenivå etter
// migreringen til Content Layer API — uten at bygget feilet, fordi .astro-filer
// ikke type-sjekkes av `tsc`. CollectionEntry er allerede riktig type.
type ProsjektEntry = CollectionEntry<"prosjekter">;

let prosjekter: ProsjektEntry[] = [];

try {
  const raw: ProsjektEntry[] = await getCollection("prosjekter");
  prosjekter = raw
    .filter((e) => !kunFremhevede || e.data.fremhevet)
    .sort((a, b) => {
      // Fremhevede prosjekter opp
      if (a.data.fremhevet && !b.data.fremhevet) return -1;
      if (!a.data.fremhevet && b.data.fremhevet)  return  1;
      // Deretter nyeste år
      return b.data.aar - a.data.aar;
    })
    .slice(0, antall);
} catch {
  // Content collection ikke klar ennå — vis tom tilstand
}

const harProsjekter = prosjekter.length > 0;
const karusellId = "prosjekt-karusell";

const Omslag = skjulTopp ? "div" : "section";
---

<Omslag
  class:list={["karusell-seksjon", !skjulTopp && "karusell-seksjon--egen section"]}
  aria-labelledby={skjulTopp ? undefined : "karusell-heading"}
>
  {/* Seksjonsheader */}
  {!skjulTopp && (
  <div class="container karusell-header reveal">
    <div class="karusell-header__left">
      <h2 class="section-title mt-2" id="karusell-heading">
        Hva vi har levert
      </h2>
    </div>
    <a
      href="/prosjekter/"
      class="btn btn--outline karusell-header__cta"
      aria-label="Se alle prosjekter"
    >
      Se alle prosjekter
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2.5 7h9M8 3.5l3.5 3.5L8 10.5"
          stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  )}

  {harProsjekter ? (
    <>
      <div
        class:list={["karusell", skjulTopp && "karusell--bleed"]}
        id={karusellId}
        role="region"
        aria-roledescription="karusell"
        aria-label="Prosjekter"
        tabindex="0"
      >
        <div class="karusell__track">
          {prosjekter.map((entry, i) => (
            <div class={`karusell__item reveal${i === 0 ? "" : `-d${Math.min(i, 3)}`}`}>
              <a
                href={`/prosjekter/${entry.id}/`}
                class="prosjekt-card"
                aria-label={`${entry.data.title} — ${entry.data.location}`}
              >
                {/* Bilde */}
                <div class="prosjekt-card__img">
                  <Bilde kilde={entry.data.heroImage} alt={entry.data.heroImage.alt} bredde={800} hoyde={500} />
                </div>

                {/* Kortinnhold */}
                <div class="prosjekt-card__body">
                  <span class="prosjekt-card__tag">
                    {KATEGORI_LABEL[entry.data.kategori]}
                  </span>

                  <h3 class="prosjekt-card__title">{entry.data.title}</h3>

                  <p class="prosjekt-card__meta">
                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                      <path d="M5.5 0C3.57 0 2 1.57 2 3.5 2 6.13 5.5 11 5.5 11S9 6.13 9 3.5C9 1.57 7.43 0 5.5 0Zm0 4.75c-.69 0-1.25-.56-1.25-1.25S4.81 2.25 5.5 2.25s1.25.56 1.25 1.25-.56 1.25-1.25 1.25Z"
                        fill="currentColor"/>
                    </svg>
                    {entry.data.location}
                    <span aria-hidden="true">·</span>
                    {entry.data.aar}
                  </p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>

      {/* Kontroller. hidden til skriptet har sett at det er mer å bla i. */}
      <div
        class:list={["karusell-kontroller", !skjulTopp && "container"]}
        data-karusell-kontroller
        hidden
      >
        <div class="karusell-fremdrift" aria-hidden="true">
          <span class="karusell-fremdrift__tommel" data-tommel></span>
        </div>

        <div class="karusell-knapper">
          <button type="button" class="karusell-pil" data-retning="-1" aria-controls={karusellId} aria-label="Forrige prosjekt">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M16 10H4m5-5-5 5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" class="karusell-pil" data-retning="1" aria-controls={karusellId} aria-label="Neste prosjekt">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </>
  ) : (
    <div class:list={[!skjulTopp && "container"]}>
      <div class="karusell-empty">
        <p>Prosjekter legges inn fortløpende.</p>
        <a href="/kontakt/" class="btn btn--outline btn--sm">Ta kontakt</a>
      </div>
    </div>
  )}
</Omslag>


<style>
  /* ── Seksjonsheader med CTA til høyre ───────────────────────────── */
  .karusell-header {
    display:         flex;
    align-items:     flex-end;
    justify-content: space-between;
    flex-wrap:       wrap;
    gap:             1.5rem;
    margin-bottom:   2.5rem;
  }

  .karusell-header__cta {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* ── Egen seksjon (når komponenten ikke står i et SeksjonsSkall) ── */
  .karusell-seksjon--egen {
    background-color: var(--color-bg);
    overflow-x:       clip;
  }

  /* ── Tom tilstand ────────────────────────────────────────────────── */
  .karusell-empty {
    display:          flex;
    align-items:      center;
    gap:              1.5rem;
    padding:          2rem;
    background-color: var(--color-bg-section);
    border-radius:    var(--r-lg);
    border:           1px dashed var(--color-border-m);
  }

  .karusell-empty p {
    color:     var(--color-text-s);
    font-size: 0.9375rem;
    margin:    0;
    max-width: none;
  }

  /* ── Keyboard-fokus på karusell ─────────────────────────────────── */
  .karusell:focus-visible {
    outline:        2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius:  var(--r-sm);
  }
</style>

<script>
  // Karusell: dra med mus, piler og fremdriftslinje.
  // Touch og tastatur (piltaster når regionen har fokus) er native scroll.
  const reduserBevegelse = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".karusell").forEach((el) => {
    const track = el.querySelector<HTMLElement>(".karusell__track");
    if (!track) return;

    const kontroller = el.nextElementSibling instanceof HTMLElement &&
      el.nextElementSibling.matches("[data-karusell-kontroller]")
        ? el.nextElementSibling
        : null;
    const tommel = kontroller?.querySelector<HTMLElement>("[data-tommel]") ?? null;
    const forrige = kontroller?.querySelector<HTMLButtonElement>('[data-retning="-1"]') ?? null;
    const neste = kontroller?.querySelector<HTMLButtonElement>('[data-retning="1"]') ?? null;

    /** Ett kort pluss mellomrommet — avstanden mellom to snappunkter. */
    const steg = () => {
      const kort = track.querySelector<HTMLElement>(".karusell__item");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (kort?.offsetWidth ?? el.clientWidth) + gap;
    };

    // ── Piler og fremdrift ────────────────────────────────────────────
    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      const maks = el.scrollWidth - el.clientWidth;
      const kanBla = maks > 2;
      if (kontroller) kontroller.hidden = !kanBla;
      if (!kanBla) return;

      const andel = el.clientWidth / el.scrollWidth;
      const posisjon = Math.min(1, Math.max(0, el.scrollLeft / maks));
      if (tommel) {
        tommel.style.width = `${andel * 100}%`;
        tommel.style.left = `${posisjon * (1 - andel) * 100}%`;
      }
      // aria-disabled og ikke disabled: en knapp med fokus som blir disabled,
      // mister fokus, og tastaturbrukeren havner øverst på siden.
      forrige?.setAttribute("aria-disabled", String(el.scrollLeft <= 2));
      neste?.setAttribute("aria-disabled", String(el.scrollLeft >= maks - 2));
    };
    const planlegg = () => {
      if (planlagt) return;
      planlagt = true;
      requestAnimationFrame(oppdater);
    };
    el.addEventListener("scroll", planlegg, { passive: true });
    new ResizeObserver(planlegg).observe(el);
    oppdater();

    [forrige, neste].forEach((knapp) =>
      knapp?.addEventListener("click", () => {
        if (knapp.getAttribute("aria-disabled") === "true") return;
        el.scrollBy({
          left: Number(knapp.dataset.retning) * steg(),
          behavior: reduserBevegelse.matches ? "auto" : "smooth",
        });
      }),
    );

    // ── Dra med mus ───────────────────────────────────────────────────
    let nede = false;
    let dratt = false;
    let startX = 0;
    let startScroll = 0;

    el.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      nede = true;
      dratt = false;
      startX = e.clientX;
      startScroll = el.scrollLeft;
    });

    el.addEventListener("pointermove", (e: PointerEvent) => {
      if (!nede) return;
      const dx = e.clientX - startX;
      // Terskel, så et vanlig klikk på et kort ikke tolkes som drag.
      if (!dratt && Math.abs(dx) < 5) return;
      if (!dratt) {
        dratt = true;
        // is-dragging slår av scroll-snap. Med snap på hopper karusellen til
        // nærmeste kort for hver pikselbevegelse, og draget føles hakkete.
        el.classList.add("is-dragging");
      }
      e.preventDefault();
      el.scrollLeft = startScroll - dx;
    });

    const slipp = () => {
      if (!nede) return;
      nede = false;
      if (!dratt) return;

      // Gli til nærmeste kort mens snap fortsatt er av, og slå det på igjen
      // når bevegelsen er ferdig.
      const s = steg();
      el.scrollTo({
        left: Math.round(el.scrollLeft / s) * s,
        behavior: reduserBevegelse.matches ? "auto" : "smooth",
      });
      let ferdig = false;
      const avslutt = () => {
        if (ferdig) return;
        ferdig = true;
        el.classList.remove("is-dragging");
      };
      el.addEventListener("scrollend", avslutt, { once: true });
      window.setTimeout(avslutt, 600);
    };
    document.addEventListener("pointerup", slipp);
    document.addEventListener("pointercancel", slipp);

    // Et drag skal ikke åpne prosjektet musa tilfeldigvis slippes over.
    el.addEventListener(
      "click",
      (e) => {
        if (!dratt) return;
        e.preventDefault();
        e.stopPropagation();
        dratt = false;
      },
      true,
    );

    // Nettleserens egen dra-og-slipp av bilder og lenker kaprer ellers draget.
    el.addEventListener("dragstart", (e) => e.preventDefault());
  });
</script>
