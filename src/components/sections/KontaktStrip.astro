---
// src/components/sections/KontaktStrip.astro
// Fire kontaktpunkter: telefon, e-post, adresse, åpningstider.
//
// Regler:
//   - NAP hentes utelukkende fra site.ts — aldri hardkodes her
//   - Telefon og e-post er klikkbare lenker (tel: og mailto:)
//   - schema.org microdata på <address>-elementet
//   - Identisk med Footer NAP og LocalBusiness-schema

import { NAP, OPENING_HOURS } from "@config/site";
---

<div
  class="strip"
  role="region"
  aria-label="Kontaktinformasjon"
  itemscope
  itemtype="https://schema.org/LocalBusiness"
>
  {/* Skjulte microdata-felt */}
  <meta itemprop="name" content={NAP.name} />
  <meta itemprop="url" content="https://brebygg.no" />

  <div class="strip__grid container">
    {/* 1. Telefon */}
    <div class="strip__item">
      <div class="strip__icon-wrap" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M17.14 13.28 14.45 13c-.64-.07-1.27.15-1.72.59l-1.9 1.9C8.27 14.3 5.7 11.74 4.5 9.17l1.91-1.91c.44-.44.66-1.07.59-1.71L6.72 2.86A1.75 1.75 0 0 0 4.98 1.25H2.5A1.75 1.75 0 0 0 .74 3.16C1.3 11.18 7.82 17.7 15.84 18.26a1.75 1.75 0 0 0 1.91-1.76v-1.47a1.75 1.75 0 0 0-1.61-1.75Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <div class="strip__text">
        <p class="strip__label">Telefon</p>
        <a
          href={`tel:${NAP.phone.replace(/\s/g, "")}`}
          class="strip__value"
          itemprop="telephone"
          aria-label={`Ring oss: ${NAP.phoneDisplay}`}
        >
          {NAP.phoneDisplay}
        </a>
        <p class="strip__sub">Vi svarer i kontortiden</p>
      </div>
    </div>

    {/* 2. E-post */}
    <div class="strip__item">
      <div class="strip__icon-wrap" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M17.5 3.33H2.5C1.58 3.33.83 4.08.83 5v10c0 .92.75 1.67 1.67 1.67h15c.92 0 1.67-.75 1.67-1.67V5c0-.92-.75-1.67-1.67-1.67Zm0 3.34L10 11.25 2.5 6.67V5L10 9.58 17.5 5v1.67Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <div class="strip__text">
        <p class="strip__label">E-post</p>
        <a
          href={`mailto:${NAP.email}`}
          class="strip__value strip__value--small"
          itemprop="email"
          aria-label={`Send e-post til ${NAP.email}`}
        >
          {NAP.email}
        </a>
        <p class="strip__sub">Svar innen én arbeidsdag</p>
      </div>
    </div>

    {/* 3. Adresse */}
    <div class="strip__item">
      <div class="strip__icon-wrap" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M10 1.67C7.24 1.67 5 3.9 5 6.67c0 4.58 5 11.66 5 11.66s5-7.08 5-11.66c0-2.77-2.24-5-5-5Zm0 6.66a1.67 1.67 0 1 1 0-3.33 1.67 1.67 0 0 1 0 3.33Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <div class="strip__text">
        <p class="strip__label">Besøksadresse</p>
        <address
          class="strip__value strip__value--small"
          style="font-style: normal;"
          itemprop="address"
          itemscope
          itemtype="https://schema.org/PostalAddress"
        >
          <span itemprop="streetAddress">{NAP.address.street}</span><br />
          <span itemprop="postalCode">{NAP.address.postalCode}</span>
          {" "}<span itemprop="addressLocality">{NAP.address.city}</span>
          <meta itemprop="addressRegion" content={NAP.address.region} />
          <meta itemprop="addressCountry" content={NAP.address.country} />
        </address>
        <p class="strip__sub">
          {NAP.address.region}, {NAP.address.countryFull}
        </p>
      </div>
    </div>

    {/* 4. Åpningstider */}
    <div class="strip__item">
      <div class="strip__icon-wrap" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M10 1.67a8.33 8.33 0 1 0 0 16.66A8.33 8.33 0 0 0 10 1.67Zm.83 9.16H9.17V5.84h1.66v5Zm0-6.66H9.17V2.5h1.66v1.67Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <div class="strip__text">
        <p class="strip__label">Åpningstider</p>
        <meta itemprop="openingHours" content="Mo-Fr 07:00-16:00" />
        <p
          class="strip__value strip__value--small"
          style="display: block; text-decoration: none;"
        >
          Man–fre
        </p>
        {/* <p
          class="strip__value strip__value--small"
          style="display: block; text-decoration: none;"
          itemprop="openingHours"
          content="Mo-Fr 07:00-16:00"
        >
          Man–fre
        </p> */}
        <p class="strip__sub">
          {OPENING_HOURS.display.replace("Man–fre: ", "")}
        </p>
      </div>
    </div>
  </div>
</div>
