---
// src/components/sections/TeamSeksjon.astro
// Teammedlemmer i kortgrid.
//
// Bilder: /public/images/team/*.webp
// Format: 400×500 px, portrett, maks 80 KB per bilde.
//
// Tomme bilder: vis initialer i farget sirkel.
// Alle tomme felter (navn, bilde) fylles inn i src/config/om-oss.ts.

import { TEAM } from "@config/om-oss";
import { NAP }  from "@config/site";

// Lag initialer fra navn (f.eks. "Ole Erik Hansen" → "OH")
function initialer(navn: string): string {
  const deler = navn.trim().split(" ");
  if (deler.length === 1 || !deler[0]) return (deler[0] ?? "?").charAt(0).toUpperCase();
  const første = deler[0]?.charAt(0) ?? "";
  const siste  = deler[deler.length - 1]?.charAt(0) ?? "";
  return (første + siste).toUpperCase();
}
---

<section
  class="team-seksjon section"
  aria-labelledby="team-heading"
>
  <div class="container">

    {/* Header */}
    <div class="section-header reveal">
      <h2 class="section-title mt-3" id="team-heading">
        Menneskene bak prosjektene
      </h2>
      <div class="divider"></div>
      <p class="section-desc">
        BRE Bygg er et lag på {TEAM.length > 4 ? "over 15" : TEAM.length} faste
        ansatte med tyngdepunkt i Sandefjord og Tønsberg. Her er de du møter
        i prosjektfasen.
      </p>
    </div>

    {/* Teamgrid */}
    <div class="team-grid" role="list" aria-label="Teammedlemmer">
      {TEAM.map((person, i) => {
        const ini = initialer(person.navn);
        return (
          <article
            class={`team-kort reveal-d${Math.min(i, 3) as 0|1|2|3}`}
            role="listitem"
          >
            {/* Bilde eller initialboble */}
            <div class="team-kort__bilde-wrap">
              <img
                src={person.bilde}
                alt={person.bildeAlt}
                loading="lazy"
                decoding="async"
                width="400"
                height="500"
                onerror={`
                  this.style.display='none';
                  this.nextElementSibling.style.display='flex';
                `}
              />
              {/* Fallback: initialboble (skjult som standard) */}
              <div
                class="team-kort__initialer"
                aria-hidden="true"
                style="display: none;"
              >
                {ini}
              </div>
            </div>

            {/* Kortinnhold */}
            <div class="team-kort__body">
              <div class="team-kort__info">
                <h3 class="team-kort__navn">{person.navn}</h3>
                <p class="team-kort__rolle">{person.rolle}</p>
              </div>

              {/* Kontaktlenker — vises kun om tilgjengelig */}
              {(person.epost || person.tlf) && (
                <div class="team-kort__kontakt">
                  {person.epost && (
                    <a
                      href={`mailto:${person.epost}`}
                      class="team-kort__kontakt-lenke"
                      aria-label={`Send e-post til ${person.navn}`}
                    >
                      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <path d="M11.67 1.08H1.33C.6 1.08.007 1.68 0 2.42v8.16C0 11.4.6 12 1.33 12h10.34C12.4 12 13 11.4 13 10.67V2.42c-.007-.74-.6-1.34-1.33-1.34Zm0 2.67L6.5 7.08 1.33 3.75V2.42L6.5 5.75l5.17-3.33v1.33Z"
                          fill="currentColor"/>
                      </svg>
                      {person.epost}
                    </a>
                  )}
                  {person.tlf && (
                    <a
                      href={`tel:${person.tlf.replace(/\s/g, "")}`}
                      class="team-kort__kontakt-lenke"
                      aria-label={`Ring ${person.navn}: ${person.tlf}`}
                    >
                      <svg width="12" height="12" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <path d="M11 8.8 9.2 8.6c-.45-.05-.9.1-1.2.4L6.65 10.3C4.72 9.34 3.14 7.76 2.18 5.83L3.5 4.5c.3-.3.45-.74.4-1.19L3.72 1.2A1.25 1.25 0 0 0 2.48.1H1.27A1.27 1.27 0 0 0 0 1.38C.38 7.32 5.18 12.12 11.12 12.5a1.27 1.27 0 0 0 1.38-1.27v-1.2A1.27 1.27 0 0 0 11 8.8Z"
                          fill="currentColor"/>
                      </svg>
                      {person.tlf}
                    </a>
                  )}
                </div>
              )}

            </div>
          </article>
        );
      })}
    </div>

    {/* Bunnlinje: ikke alle er med her */}
    <p class="team-merknad reveal">
      BRE Bygg har {/* Erstatt med faktisk antall */}15–20 ansatte i fast stilling,
      inkludert håndverkere og fagarbeidere på byggeplass. Kontakt oss på{" "}
      <a href={`mailto:${NAP.email}`}>{NAP.email}</a>{" "}
      for spørsmål om ledig kapasitet.
    </p>

  </div>
</section>


<style>
  .team-seksjon {
    background-color: var(--color-bg-white);
  }

  /* ── Grid ──────────────────────────────────────────────────────────── */
  .team-grid {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap:                   1.5rem;
    margin-bottom:         2.5rem;
  }

  @media (max-width: 479px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  /* ── Teamkort ──────────────────────────────────────────────────────── */
  .team-kort {
    background-color: var(--color-bg);
    border-radius:    var(--r-lg);
    overflow:         hidden;
    border:           1px solid var(--color-border);
    transition:       box-shadow var(--transition-base), transform var(--transition-base);
  }

  .team-kort:hover {
    box-shadow: var(--shadow-md);
    transform:  translateY(-3px);
  }

  /* ── Bilderamme ──────────────────────────────────────────────────── */
  .team-kort__bilde-wrap {
    position:     relative;
    aspect-ratio: 4 / 5;
    overflow:     hidden;
    background-color: var(--color-bg-section);
  }

  .team-kort__bilde-wrap img {
    width:       100%;
    height:      100%;
    object-fit:  cover;
    object-position: center top;
    transition:  transform 0.5s var(--ease-out);
    display:     block;
  }

  .team-kort:hover .team-kort__bilde-wrap img {
    transform: scale(1.04);
  }

  /* Fallback: initialboble */
  .team-kort__initialer {
    position:         absolute;
    inset:            0;
    align-items:      center;
    justify-content:  center;
    font-family:      var(--ff-display);
    font-size:        2.5rem;
    font-weight:      700;
    color:            var(--color-primary);
    background-color: var(--color-bg-section);
    letter-spacing:   -0.02em;
  }

  /* ── Kortinnhold ─────────────────────────────────────────────────── */
  .team-kort__body {
    padding: 1.125rem 1.25rem 1.25rem;
  }

  .team-kort__info {
    margin-bottom: 0.75rem;
  }

  .team-kort__navn {
    font-size:      1rem;
    font-weight:    700;
    color:          var(--color-text);
    margin-bottom:  0.2rem;
    letter-spacing: -0.01em;
    line-height:    1.3;
  }

  .team-kort__rolle {
    font-size:   0.8125rem;
    color:       var(--color-primary);
    font-weight: 600;
    margin:      0;
    max-width:   none;
  }

  /* ── Kontaktlenker ────────────────────────────────────────────────── */
  .team-kort__kontakt {
    display:        flex;
    flex-direction: column;
    gap:            0.3rem;
    padding-top:    0.75rem;
    border-top:     1px solid var(--color-border);
  }

  .team-kort__kontakt-lenke {
    display:         flex;
    align-items:     center;
    gap:             0.4rem;
    font-size:       0.75rem;
    color:           var(--color-text-m);
    text-decoration: none;
    transition:      color var(--transition-fast);
    white-space:     nowrap;
    overflow:        hidden;
    text-overflow:   ellipsis;
  }

  .team-kort__kontakt-lenke svg { flex-shrink: 0; }

  .team-kort__kontakt-lenke:hover {
    color: var(--color-primary);
  }

  /* ── Bunnlinje ───────────────────────────────────────────────────── */
  .team-merknad {
    font-size:  0.9rem;
    color:      var(--color-text-s);
    text-align: center;
    max-width:  var(--reading-width);
    margin:     0 auto;
  }

  .team-merknad a {
    color: var(--color-primary);
  }
</style>
