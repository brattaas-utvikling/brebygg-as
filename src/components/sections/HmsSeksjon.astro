---
// src/components/sections/HmsSeksjon.astro
// HMS og sertifiseringer — lys seksjon.
//
// Venstre: introduksjon + HMS-punktliste (hva vi faktisk gjør)
// Høyre:   sertifiseringsbadges + nedlastingslenke til HMS-egenerklæring

import { HMS_PUNKTER } from "@config/om-oss";
---

<section
  class="hms-seksjon section"
  aria-labelledby="hms-heading"
>
  <div class="container">
    <div class="hms-grid">

      {/* Venstre: HMS-innhold */}
      <div class="hms-tekst reveal">

        <span class="eyebrow">HMS</span>
        <h2 class="section-title mt-3" id="hms-heading">
          Helse, miljø og sikkerhet
        </h2>
        <div class="divider"></div>

        <p>
          BRE Bygg er godkjent etter kravene i byggherreforskriften. Vi
          utarbeider SHA-plan for alle prosjekter og gjennomfører ukentlige
          vernerunder på aktive byggeplasser.
        </p>

        <p class="mt-4">
          Krav til HMS-egenerklæring fra underentreprenører er ikke noe vi
          spør om — det er et vilkår for å jobbe med oss.
        </p>

        {/* HMS-punkter */}
        <ul class="hms-liste" aria-label="HMS-tiltak">
          {HMS_PUNKTER.map(punkt => (
            <li class="hms-liste__item">
              <span class="hms-liste__hake" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path
                    d="M2.5 7.5L5.5 10.5L11.5 3.5"
                    stroke="var(--color-primary)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span>{punkt}</span>
            </li>
          ))}
        </ul>

      </div>

      {/* Høyre: sertifiseringer
           MIDLERTIDIG UTE. Blokken viste «Mesterbrev», «Sentral godkjenning —
           Tiltaksklasse 2» og «Godkjent lærebedrift» uten at noen av dem var
           verifisert. Det er lovregulerte påstander, ikke markedsføring.
           Sett inn igjen når SERTIFISERINGER er bekreftet i om-oss.ts. */}
      <div class="hms-sertifiseringer reveal-d1">

        <div class="sert-header">
          <h3 class="sert-tittel">Slik jobber vi med sikkerhet</h3>
          <p class="sert-sub">
            Dokumentasjon på godkjenninger sendes på forespørsel.
          </p>
        </div>

        {/* Kontaktoppfordring for HMS-dokumentasjon */}
        <div class="sert-forespørsel">
          <p>
            Trenger du HMS-egenerklæring eller sentralgodkjenningsbevis
            for et anbud?
          </p>
          <a href="/kontakt/" class="btn btn--outline btn--sm">
            Send forespørsel
          </a>
        </div>

      </div>

    </div>
  </div>
</section>


<style>
  .hms-seksjon {
    background-color: var(--color-bg-section);
  }

  /* ── To-kolonne grid ──────────────────────────────────────────────── */
  .hms-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(3rem, 6vw, 5rem);
    align-items:           start;
  }

  @media (max-width: 767px) {
    .hms-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ── HMS-tekst ────────────────────────────────────────────────────── */
  .hms-tekst p {
    color:   var(--color-text-m);
    max-width: var(--reading-width);
  }

  .mt-4 { margin-top: 1rem; }

  /* ── HMS-liste ────────────────────────────────────────────────────── */
  .hms-liste {
    list-style:  none;
    padding:     0;
    margin:      1.5rem 0 0;
    display:     flex;
    flex-direction: column;
    gap:         0.75rem;
  }

  .hms-liste__item {
    display:     flex;
    align-items: flex-start;
    gap:         0.625rem;
    font-size:   0.9375rem;
    color:       var(--color-text-m);
    line-height: 1.55;
  }

  .hms-liste__hake {
    flex-shrink: 0;
    margin-top:  0.15rem;
    width:       20px;
    height:      20px;
    display:     flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(132, 133, 110, 0.1);
    border-radius: 50%;
  }

  /* ── Sertifiseringer (høyre kolonne) ─────────────────────────────── */
  .sert-header {
    margin-bottom: 1.5rem;
  }

  .sert-tittel {
    font-size:      1.125rem;
    font-weight:    700;
    color:          var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom:  0.375rem;
    line-height:    1.3;
  }

  .sert-sub {
    font-size: 0.875rem;
    color:     var(--color-text-s);
    margin:    0;
    max-width: none;
  }

  /* ── Sertifiserings-grid ─────────────────────────────────────────── */
  .sert-grid {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        0.625rem;
  }

  .sert-badge {
    display:          flex;
    align-items:      center;
    gap:              0.875rem;
    padding:          0.875rem 1rem;
    background-color: var(--color-bg-white);
    border:           1px solid var(--color-border);
    border-radius:    var(--r-md);
    transition:       box-shadow var(--transition-base),
                      border-color var(--transition-base);
  }

  .sert-badge:hover {
    box-shadow:   var(--shadow-sm);
    border-color: var(--color-primary);
  }

  .sert-badge__ikon {
    flex-shrink: 0;
    display:     flex;
    align-items: center;
    justify-content: center;
  }

  .sert-badge__tekst {
    display:        flex;
    flex-direction: column;
    gap:            0.1rem;
  }

  .sert-badge__navn {
    font-size:   0.9375rem;
    font-weight: 600;
    color:       var(--color-text);
    line-height: 1.3;
  }

  .sert-badge__info {
    font-size: 0.75rem;
    color:     var(--color-text-s);
  }

  /* ── Forespørselsblokk ───────────────────────────────────────────── */
  .sert-forespørsel {
    margin-top:       1.5rem;
    padding:          1.25rem;
    background-color: var(--color-bg-white);
    border:           1px dashed var(--color-border-m);
    border-radius:    var(--r-md);
    display:          flex;
    align-items:      center;
    justify-content:  space-between;
    flex-wrap:        wrap;
    gap:              1rem;
  }

  .sert-forespørsel p {
    font-size: 0.875rem;
    color:     var(--color-text-m);
    margin:    0;
    max-width: 260px;
    line-width: 1.5;
  }
</style>
