---
import SeksjonsSkall from "../SeksjonsSkall.astro";
interface Props { blokk: Record<string, any> }
const { blokk } = Astro.props;
const punkter = Array.isArray(blokk.punkter) ? blokk.punkter : [];
---
<SeksjonsSkall tema={blokk.tema} eyebrow={blokk.eyebrow} overskrift={blokk.overskrift}>
  <ul class="baerekraft-liste" role="list">
    {punkter.map((p: any) => (
      <li class="baerekraft-liste__post">
        <span class="baerekraft-liste__verdi">{p.verdi}</span>
        <span class="baerekraft-liste__label">{p.label}</span>
      </li>
    ))}
  </ul>
</SeksjonsSkall>

<style>
  .baerekraft-liste {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .baerekraft-liste__post { display: flex; flex-direction: column; gap: 0.35rem; }
  .baerekraft-liste__verdi {
    font-family: var(--ff-display); font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700; line-height: 1;
  }
  .baerekraft-liste__label { font-size: 0.95rem; opacity: 0.85; }
</style>
