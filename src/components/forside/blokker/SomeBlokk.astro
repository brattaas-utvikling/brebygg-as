---
// src/components/forside/blokker/SomeBlokk.astro
//
// Sosiale medier: bilde over hele bredden med mørkt slør og tre lenker.
// Valgt som variant B blant fem retninger (se .21st/design.json).
//
// Står ikke i SeksjonsSkall. Skallet eier bakgrunnsfarge via tema, men her er
// bakgrunnen et bilde og teksten alltid lys, så det finnes ikke noe tema å
// velge. Rytmevalideringen i Sanity regner blokken som mørk.
//
// Lenkene kommer fra SOCIAL i site.ts, samme kilde som sameAs i JSON-LD, så
// de to kan ikke drive fra hverandre.
//
// Tre oppsett:
//   mobil  (< 640)    slør nedenfra, tekst nederst, knapper i full bredde
//   iPad   (640–1023) slør nedenfra, knapper på én rad
//   desktop (≥ 1024)  bildet i høyre ~60 %, glir inn i mørk flate bak teksten
//
// Hvorfor ikke fullbredde på desktop: bildet er stående (952×1024). I et bredt
// felt skaleres det til full bredde, og da kan object-position ikke flytte
// motivet sideveis — mobilen havnet under ingressen fra 1024 px og oppover.

import Bilde from "@components/sanity/Bilde.astro";
import SomeIkon from "@components/ui/SomeIkon.astro";
import { SOME_KANALER } from "@config/site";

interface Props {
  blokk: Record<string, any>;
}
const { blokk } = Astro.props;

// Bildet er dekor bak teksten, så alt er tom uansett kilde.
const bilde = blokk.bilde ?? {
  src: "/images/folg-oss-sosiale-medier.webp",
  alt: "",
  width: 1536,
  height: 1024,
};

const overskriftId = `some-${blokk._key ?? "blokk"}`;

---

<section class="some" aria-labelledby={overskriftId}>
  <div class="some__media" aria-hidden="true">
    <Bilde kilde={bilde} alt="" sizes="100vw" fyll />
  </div>
  <div class="some__slor slor" aria-hidden="true"></div>

  <div class="container some__innhold text-inv reveal slor-tekst">
    <h2 class="section-title" id={overskriftId}>{blokk.overskrift}</h2>
    {blokk.ingress && <p class="section-desc mt-3">{blokk.ingress}</p>}

    <ul class="some__knapper" role="list">
      {
        SOME_KANALER.map((k) => (
          <li>
            <a
              href={k.url}
              class="btn btn--outline-inv some__knapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="some__ikon"><SomeIkon kanal={k.id} /></span>
              {k.navn}
              <span class="some__sr">(åpnes i ny fane)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ── Rammen ─────────────────────────────────────────────────────────── */
  .some {
    position: relative;
    isolation: isolate;
    /* clip og ikke hidden: hidden gjør seksjonen til en scroll-container,
       og .reveal inni kobler seg da til en tidslinje som aldri går. */
    overflow: clip;
    display: grid;
    align-items: end;
    /* Mobil: høy nok til at mobilen i bildet synes over teksten. */
    min-height: clamp(36rem, 145vw, 46rem);
    padding-block: var(--section-padding-y);
    /* Vises til bildet er lastet, og hvis det aldri lastes. */
    background-color: var(--color-bg-dark-2);
  }

  @media (min-width: 640px) {
    .some {
      min-height: clamp(32rem, 78vw, 42rem);
    }
  }

  @media (min-width: 1024px) {
    .some {
      align-items: center;
      min-height: clamp(32rem, 42vw, 40rem);
      /* Samme farge som sløret, så overgangen til bildet blir sømløs. */
      background-color: rgb(var(--rgb-dark-2));
    }
  }

  /* ── Bildet ─────────────────────────────────────────────────────────── */
  .some__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* :global fordi <img> rendres av Bilde-komponenten og ikke får scope-
     attributtet herfra. object-position følger hvor mobilen står i bildet. */
  .some__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
  }

  @media (min-width: 640px) {
    .some__media :global(img) {
      object-position: 65% 38%;
    }
  }

  @media (min-width: 1024px) {
    .some__media {
      left: 38%;
    }
    .some__media :global(img) {
      object-position: 50% 40%;
    }
  }

  /* ── Sløret ─────────────────────────────────────────────────────────
     Mørkest der teksten står. Uten det ville lesbarheten avhenge av hvilket
     bilde klienten velger i Studio. */
  /* Felles slør. Mobil og iPad: tekstblokken har sitt eget festede slør
     (.slor-tekst), og .slor her dekker bare luften under den. Desktop: helt
     mørk til bildekanten på 38 %, så overgang inn i bildet. */
  .some__slor {
    position: absolute;
    inset: 0;
    z-index: -1;
    --slor-retning: 0deg;
    --slor-fast: 20%;
  }

  @media (min-width: 1024px) {
    .some__slor {
      --slor-retning: 90deg;
      --slor-fast: 38%;
    }
    /* Desktop: teksten står på den faste flaten til venstre, så tekstblokken
       trenger ikke sitt eget slør. */
    .some__innhold.slor-tekst {
      background-image: none;
      padding-top: 0;
    }
  }

  /* ── Innhold ────────────────────────────────────────────────────────── */
  .some__innhold > * {
    max-width: 36rem;
  }

  /* Smalere på iPad liggende, så teksten holder seg på den mørke flaten. */
  @media (min-width: 1024px) {
    .some__innhold > * {
      max-width: 30rem;
    }
  }

  @media (min-width: 1280px) {
    .some__innhold > * {
      max-width: 34rem;
    }
  }

  .some__knapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .some__knapper {
      display: flex;
      flex-wrap: wrap;
    }
  }

  .some__knapp {
    justify-content: center;
    width: 100%;
    /* Trykkflate på minst 48 px. */
    min-height: 3rem;
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .some__knapp {
      width: auto;
    }
  }

  .some__knapp:focus-visible {
    outline: 2px solid var(--color-primary-l);
    outline-offset: 3px;
  }

  .some__ikon {
    display: inline-grid;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .some__ikon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .some__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
