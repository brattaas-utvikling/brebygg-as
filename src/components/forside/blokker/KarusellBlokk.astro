---
import SeksjonsSkall from "../SeksjonsSkall.astro";
import ProsjektKarusell from "@components/sections/ProsjektKarusell.astro";
interface Props { blokk: Record<string, any> }
const { blokk } = Astro.props;
---
{/* karusell-skall: kortene går ut til skjermkanten, og skallet kutter det
    som stikker ut sideveis så siden ikke får horisontal scroll. */}
<SeksjonsSkall tema={blokk.tema} overskrift={blokk.overskrift} class="karusell-skall">
  <ProsjektKarusell
    skjulTopp
    antall={typeof blokk.antall === "number" ? blokk.antall : 8}
    kunFremhevede={blokk.kunFremhevede === true}
  />
</SeksjonsSkall>
