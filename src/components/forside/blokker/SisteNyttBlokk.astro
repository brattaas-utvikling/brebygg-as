---
// src/components/forside/blokker/SisteNyttBlokk.astro
//
// Siste nytt: de nyeste sakene fra «Siste nytt» i Studio.
//
// Hentes ved bygg, som alt annet innhold. Utløpte saker (visTil i fortiden)
// er filtrert bort i spørringen; de forsvinner derfor ved neste bygg, ikke på
// dagen. Uten publiserte saker rendres ingenting — ingen tom seksjon.
//
// Karusell som prosjektkarusellen på forsiden: sakene står på én rad som
// går ut til skjermkanten, med piler og fremdriftslinje under. Samme
// oppførsel (dra med mus, sveip, piltaster) fra src/scripts/karusell.ts.
// Maks 10 saker.
//
// Bare første bilde vises i saken. En bildekarusell inni en sak lå tidligere
// inni lista, men inni en sidelengs karusell ville to sveip i samme retning
// kjempet om samme bevegelse. Resten av bildene står i innlegget lenken går
// til.
//
// Sakene står uten kortramme, rett på seksjonsflaten. Da følger tekstfargene
// temaet kunden velger (lys eller mørk), og siden får ikke enda et
// kortrutenett.
//
// `nyheter` kan sendes inn som prop. Brukes bare til testing; ellers hentes
// sakene fra Sanity.

import SeksjonsSkall from "../SeksjonsSkall.astro";
import Bilde from "@components/sanity/Bilde.astro";
import SomeIkon from "@components/ui/SomeIkon.astro";
import { BRUKER_SANITY, sanityKlient } from "@lib/sanity/client";
import { Q_NYHETER } from "@lib/sanity/queries";
import { erMorkt } from "@lib/sanity/tema";
import { SOME_KANALER } from "@config/site";
import type { Bilde as BildeType } from "@/content.config";

type Nyhet = {
  _id: string;
  tittel: string;
  dato: string;
  tekst?: string | null;
  lenke?: string | null;
  plattform?: "linkedin" | "instagram" | "facebook" | "annet" | null;
  fremhevet?: boolean;
  bilder: (BildeType & Record<string, unknown>)[];
};

interface Props {
  blokk: Record<string, any>;
  nyheter?: Nyhet[];
}

const { blokk } = Astro.props;
const antall = Math.min(10, Math.max(1, Number(blokk.antall) || 10));
const karusellId = `nytt-karusell-${blokk._key ?? "forside"}`;
const idag = new Date().toISOString().slice(0, 10);

const nyheter: Nyhet[] =
  Astro.props.nyheter ??
  (BRUKER_SANITY ? await sanityKlient().fetch<Nyhet[]>(Q_NYHETER, { idag, antall }) : []);

const synlige = nyheter.filter((n) => Array.isArray(n.bilder) && n.bilder.length > 0);

const LENKETEKST = {
  linkedin:  "Se innlegget på LinkedIn",
  instagram: "Se innlegget på Instagram",
  facebook:  "Se innlegget på Facebook",
  annet:     "Les mer",
} as const;

const datoTekst = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" });

const visSome = blokk.visSome !== false;
const mork = erMorkt(blokk.tema ?? "lys");
---

{synlige.length > 0 && (
  <SeksjonsSkall tema={blokk.tema} overskrift={blokk.overskrift ?? "Siste nytt"} ingress={blokk.ingress} class="siste-nytt karusell-skall">
    <div
      class="karusell karusell--bleed reveal"
      id={karusellId}
      role="region"
      aria-roledescription="karusell"
      aria-label={blokk.overskrift ?? "Siste nytt"}
      tabindex="0"
    >
      <ul class="karusell__track" role="list">
        {synlige.map((n) => (
          <li class="karusell__item nytt">
            <div class="nytt__bilde">
              <Bilde
                kilde={n.bilder[0]!}
                fyll
                sizes="(max-width: 639px) 85vw, 380px"
                bredde={800}
                hoyde={600}
              />
            </div>

            <div class="nytt__tekst">
              <time class="nytt__dato" datetime={n.dato}>{datoTekst(n.dato)}</time>
              <h3 class="nytt__tittel">{n.tittel}</h3>
              {n.tekst && <p class="nytt__ingress">{n.tekst}</p>}
              {n.lenke && (
                <a class="nytt__lenke" href={n.lenke} target="_blank" rel="noopener noreferrer">
                  {LENKETEKST[n.plattform ?? "annet"] ?? LENKETEKST.annet}
                  <span class="sr-only"> (åpnes i ny fane)</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/* Kontroller. hidden til skriptet har sett at det er mer å bla i. */}
    <div class="karusell-kontroller" data-karusell-kontroller hidden>
      <div class="karusell-fremdrift" aria-hidden="true">
        <span class="karusell-fremdrift__tommel" data-tommel></span>
      </div>
      <div class="karusell-knapper">
        <button type="button" class="karusell-pil" data-retning="-1" aria-controls={karusellId} aria-label="Forrige sak">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M16 10H4m5-5-5 5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="karusell-pil" data-retning="1" aria-controls={karusellId} aria-label="Neste sak">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    {visSome && (
      <ul class="nytt-some" role="list" aria-label="Følg oss">
        {SOME_KANALER.map((k) => (
          <li>
            <a
              href={k.url}
              class:list={["btn", "btn--sm", mork ? "btn--outline-inv" : "btn--outline"]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <SomeIkon kanal={k.id} />
              {k.navn}
              <span class="sr-only"> (åpnes i ny fane)</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </SeksjonsSkall>
)}

<style>
  /* Karusellen selv (bredde, snap, piler) er felles med prosjektkarusellen:
     .karusell* i globals.css. Her bare selve saken. */
  .karusell__track {
    margin: 0;
    list-style: none;
  }

  /* Saken: bilde øverst, tekst under, lenken nederst. Kortene i raden er
     like høye (flex-raden strekker dem), så lenkene står på linje. */
  .nytt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .nytt__bilde {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .nytt__tekst {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
  }

  .nytt__dato {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-uthev);
  }

  .nytt__tittel {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .nytt__ingress {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Tre linjer når saken har lenke: hele teksten står i innlegget lenken
     går til. Uten lenke vises alt, ellers ville resten vært umulig å lese.
     Klippingen er bare visuell; skjermlesere får hele teksten. */
  .nytt:has(.nytt__lenke) .nytt__ingress {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .nytt__lenke {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    min-height: 24px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nytt-some {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nytt-some :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>

<script>
  // Felles med prosjektkarusellen: se src/scripts/karusell.ts.
  import "@/scripts/karusell";
</script>
