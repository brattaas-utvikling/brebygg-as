---
import SeksjonsSkall from "../SeksjonsSkall.astro";
interface Props { blokk: Record<string, any> }
const { blokk } = Astro.props;
const pro = blokk.prosjekt;
---
{pro?.id && (
  <SeksjonsSkall tema={blokk.tema}>
    <a href={`/prosjekter/${pro.id}/`} class="paagaende">
      <span class="paagaende__merke">Pågående nå</span>
      <span class="paagaende__tittel">{pro.tittel}</span>
      {pro.sted && <span class="paagaende__sted">{pro.sted}</span>}
    </a>
  </SeksjonsSkall>
)}

<style>
  .paagaende {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    background-color: var(--color-bg-white);
    color: inherit; text-decoration: none;
    transition: border-color var(--transition-fast);
  }
  .paagaende:hover { border-color: var(--color-primary); color: inherit; }
  .paagaende__merke {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-primary-d);
  }
  .paagaende__tittel { font-family: var(--ff-display); font-weight: 600; font-size: 1.125rem; }
  .paagaende__sted { font-size: 0.9rem; color: var(--color-text-s); }
</style>
