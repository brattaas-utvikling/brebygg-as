---
import SeksjonsSkall from "../SeksjonsSkall.astro";
interface Props { blokk: Record<string, any> }
const { blokk } = Astro.props;
const tall = Array.isArray(blokk.tall) ? blokk.tall : [];
---
<SeksjonsSkall tema={blokk.tema}>
  <dl class="stats-rad">
    {tall.map((t: any) => (
      <div class="stats-rad__post">
        <dt class="stats-rad__verdi">{t.verdi}</dt>
        <dd class="stats-rad__label">{t.label}</dd>
      </div>
    ))}
  </dl>
</SeksjonsSkall>
