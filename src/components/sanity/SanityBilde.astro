---
// src/components/sanity/SanityBilde.astro
//
// Ett sted for alle Sanity-bilder.
//
// Fire ting løses her, én gang, i stedet for i hver komponent:
//   - srcset i faste bredder med auto=format (AVIF der det støttes)
//   - width/height fra asset.metadata.dimensions → CLS blir null uten
//     manuelt arbeid
//   - LQIP fra asset.metadata.lqip som bakgrunn → blur-up gratis, ingen
//     ekstra forespørsel
//   - alt er en PÅKREVD prop. Kombinert med validation i Sanity-skjemaet er
//     det strukturelt umulig å få et bilde uten alt-tekst ut på siden.

import type { Image } from "@sanity/types";
import { bildeUrl, byggSrcset } from "@lib/sanity/image";

interface Props {
  kilde:   Image & { asset?: { metadata?: { dimensions?: { width: number; height: number }; lqip?: string } } };
  alt:     string;
  /** sizes-attributtet. Uten dette laster nettleseren største variant. */
  sizes?:  string;
  /** LCP-bilde: eager + fetchpriority="high". Kun ett per side. */
  prioritet?: boolean;
  class?:  string;
  /** Overstyr høyde/bredde-forhold, f.eks. "16/9" på et kort. */
  forhold?: string;
  /**
   * Fyll forelderen i stedet for å følge bildets eget forhold.
   *
   * Må settes her, ikke i en global regel. `.sanity-bilde { height: auto }`
   * nedenfor er scoped, altså ULAGDELT, og ulagdelte deklarasjoner slår alt
   * som ligger i et @layer uansett spesifisitet. `.hero__bg img { height:
   * 100% }` i globals.css lå i @layer components og hadde derfor aldri noen
   * effekt: hero-bildet beholdt sitt eget forhold og dekket bare toppen av
   * seksjonen. Målt på 420x1000 var bildet 420x360 i en container på 420x928.
   *
   * Forelderen må ha en definert høyde for at dette skal gi mening.
   */
  fyll?: boolean;
}

const {
  kilde,
  alt,
  sizes = "(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 800px",
  prioritet = false,
  class: klasse,
  forhold,
  fyll = false,
} = Astro.props;

const meta   = kilde?.asset?.metadata;
const dim    = meta?.dimensions;
const lqip   = meta?.lqip;

// fit=max skalerer aldri opp, så det gir ingen mening å be om bredder over
// originalen.
const maksBredde = dim?.width ?? 2000;

// Fokuspunktet kunden setter i Studio (hotspot). Gjelder bare når bildet
// fyller en ramme med annet format og må beskjæres. Uten det sentreres bildet.
const hotspot = (kilde as { hotspot?: { x?: number; y?: number } } | undefined)?.hotspot;
// `forhold` gir også beskjæring: bildet tvinges inn i et annet format, og
// uten object-fit: cover ble det strukket (3:2-bildet i «Bærekraft 2026» på
// forsiden ble klemt til 4:3).
const beskjaeres = fyll || Boolean(forhold);
const fokus = beskjaeres && typeof hotspot?.x === "number" && typeof hotspot?.y === "number"
  ? `${(hotspot.x * 100).toFixed(1)}% ${(hotspot.y * 100).toFixed(1)}%`
  : undefined;
---

<img
  src={bildeUrl(kilde, Math.min(1200, maksBredde))}
  srcset={byggSrcset(kilde, maksBredde)}
  sizes={sizes}
  alt={alt}
  width={dim?.width}
  height={dim?.height}
  loading={prioritet ? "eager" : "lazy"}
  decoding={prioritet ? "sync" : "async"}
  fetchpriority={prioritet ? "high" : "auto"}
  class:list={["sanity-bilde", klasse]}
  data-fyll={fyll ? "" : undefined}
  style={{
    ...(lqip ? { backgroundImage: `url(${lqip})` } : {}),
    ...(forhold ? { aspectRatio: forhold, objectFit: "cover", width: "100%" } : {}),
    ...(fokus ? { objectPosition: fokus } : {}),
  }}
/>

<style>
  .sanity-bilde {
    display: block;
    max-width: 100%;
    height: auto;
    /* LQIP-en er 20 px bred og strekkes over hele flaten. Uten cover blir den
       gjentatt som fliser. */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Attributt og ikke en egen klasse, så selektoren henger på .sanity-bilde
     som står statisk i malen. Kommer etter regelen over og vinner på
     rekkefølge — samme stilblokk, samme lag. */
  .sanity-bilde[data-fyll] {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
</style>
