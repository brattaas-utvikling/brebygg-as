---
// src/components/seo/JsonLd.astro
// Serialiserer JSON-LD server-side.
//
// set:html og ikke {JSON.stringify(...)}: Astro escaper uttrykk i tekstnoder,
// og escapede anførselstegn gir ugyldig JSON-LD.
//
// </script> i en strengverdi ville avslutte script-taggen tidlig. Vi bryter
// sekvensen. Ingen av dagens data inneholder den, men schema kommer fra Sanity
// fra fase 6 og da er inputen redaktørstyrt.

interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;

const json = JSON.stringify(schema)
  .replace(/<\/script/gi, "<\\/script")
  .replace(/<!--/g, "\\u003C!--");
---

<script is:inline type="application/ld+json" set:html={json}></script>
