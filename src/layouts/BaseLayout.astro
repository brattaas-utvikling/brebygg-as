---
// src/layouts/BaseLayout.astro
// HTML-skallet for brebygg.no.
//
// Endringer fra v1:
//   - Den utkommenterte duplikaten av hele filen er slettet. Den var 8,5 KB og
//     ble sendt til nettleseren på hver eneste sidelast — Astro fjerner ikke
//     HTML-kommentarer. Målt før: 23,8 % av forsidens HTML var kommentarer.
//   - Fontlasting flyttet til <Font /> fra astro:assets. Fjerner to preconnect,
//     preload-as-style, media="print"-hacken, den inline onload-handleren (som
//     ville blokkert enhver CSP) og <noscript>-duplikaten.
//   - De fem inline-skriptene er redusert til to. Progress-bar og karusell-drag
//     hørte hjemme i komponentene som bruker dem — de lastet på /kontakt/ også.
//   - Skip-link bruker .skip-link fra globals.css i stedet for en Tailwind-kjede.
//   - PageMeta bærer nå pageType og noindex, så og:type="article" kan faktisk
//     settes på prosjektsidene.

import type { PageMeta } from "@config/site";
import { SEO_DEFAULTS, NAP } from "@config/site";
import { resolveMeta, absoluteUrl } from "@lib/seo/meta";
import { erSanityBilde, type Bilde } from "@/content.config";
import { heroPreload } from "@lib/sanity/image";
import JsonLd from "@components/seo/JsonLd.astro";
import { Font } from "astro:assets";
import "@styles/globals.css";

interface Props {
  meta:       PageMeta;
  schema:     Record<string, unknown>;
  /**
   * LCP-bildet. Preloades med høy prioritet.
   *
   * Tar imot enten en streng (lokal fil) eller et Sanity-bilde. For Sanity
   * bygges imagesrcset som er identisk med det <SanityBilde> ber om — ellers
   * laster nettleseren originalen i tillegg til den transformerte varianten.
   */
  heroImage?: string | (Bilde & Record<string, unknown>);
  /** Må matche sizes på hero-bildet, ellers velger preload en annen kandidat. */
  heroSizes?: string;
  bodyClass?: string;
}

const { meta, schema, heroImage, heroSizes = "100vw", bodyClass = "" } = Astro.props;

const heroPre =
  heroImage && typeof heroImage !== "string" && erSanityBilde(heroImage)
    ? heroPreload(heroImage as never, heroSizes)
    : null;

const resolved     = resolveMeta(meta);
const canonicalUrl = absoluteUrl(resolved.canonical);
const ogImageUrl   = absoluteUrl(resolved.ogImage);
---

<!doctype html>
<html lang="nb" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolved.title}</title>
    <meta name="description" content={resolved.description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="nb-NO" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    {resolved.noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

    <meta property="og:type"         content={resolved.pageType === "article" ? "article" : "website"} />
    <meta property="og:title"        content={resolved.title} />
    <meta property="og:description"  content={resolved.description} />
    <meta property="og:url"          content={canonicalUrl} />
    <meta property="og:image"        content={ogImageUrl} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={`${NAP.name} — totalentreprenør i Vestfold`} />
    <meta property="og:locale"       content={SEO_DEFAULTS.locale} />
    <meta property="og:site_name"    content={NAP.name} />

    <meta name="twitter:card"        content={SEO_DEFAULTS.twitterCard} />
    <meta name="twitter:title"       content={resolved.title} />
    <meta name="twitter:description" content={resolved.description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    {/* Faviconet er fjellmerket alene, kvadratisk. /favicon.svg er hele
        ordmerket i 1536×1039 — det er headerlogoen, og den blir uleselig
        letterboxet i en 16 px fane. favicon.ico og apple-touch-icon.png
        manglet helt og ga 404 på hver sidelast. */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2C4251" />

    {/* Selvhostet Plus Jakarta Sans. Astro genererer @font-face, preload for
        den kritiske vekten og en metrisk justert fallback. */}
    <Font cssVariable="--font-jakarta" preload />

    {heroPre ? (
      <link
        rel="preload"
        as="image"
        href={heroPre.href}
        imagesrcset={heroPre.imagesrcset}
        imagesizes={heroPre.imagesizes}
        fetchpriority="high"
      />
    ) : typeof heroImage === "string" && heroImage ? (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    ) : null}

    <JsonLd schema={schema} />
    <slot name="head" />
  </head>

  <body class={`antialiased ${bodyClass}`}>
    <a href="#main-content" class="skip-link">Hopp til innhold</a>

    <slot />

    <script>
      // Scroll-reveal, med sikkerhetsnett.
      //
      // Reveal-klassene starter på opacity: 0 og settes til 1 av en
      // scroll-drevet animasjon. Går animasjonen aldri i gang, blir innholdet
      // stående usynlig — og det har skjedd: seksjoner forsvant fra forsiden
      // uten at noe feilet, fordi `animation-range: entry` aldri ble passert.
      //
      // Regelen her er at innhold vinner over bevegelse. Er et element
      // fortsatt usynlig etter at siden har lastet, fjernes reveal-klassen og
      // elementet vises. Da kan en dekorativ effekt aldri skjule noe.

      // Heroen er med her fordi den har nøyaktig samme feilmodus: h1, ingress
      // og knapper starter på opacity: 0 med sin egen animasjon i Hero.astro.
      // Går den aldri i gang, står sidens viktigste element usynlig — og det
      // er nettopp det denne funksjonen finnes for å hindre.
      const REVEAL =
        ".reveal, .reveal-d1, .reveal-d2, .reveal-d3, " +
        ".hero__heading, .hero__lead, .hero__actions";

      const harScrollTimeline =
        typeof CSS !== "undefined" && CSS.supports("animation-timeline", "view()");

      if (!harScrollTimeline) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -48px 0px" }
        );
        document.querySelectorAll(REVEAL).forEach((el) => observer.observe(el));
      }

      // Sikkerhetsnettet. Kjøres etter load, og én gang til ved første scroll
      // i tilfelle noe var midt i en animasjon på første måling.
      function tvingSynlig() {
        for (const el of document.querySelectorAll<HTMLElement>(REVEAL)) {
          if (parseFloat(getComputedStyle(el).opacity) > 0.05) continue;

          // Er det en animasjon i gang på elementet, gjør den jobben sin —
          // da er lav opacity bare et mellomsteg. Uten denne sjekken avbrøt
          // nettet hero-sekvensen mens den fortsatt spilte, fordi den starter
          // med 0,2 s forsinkelse og fill-mode forwards: i forsinkelsen står
          // elementet på sin egen opacity: 0, og så ut som om det hang.
          const gaar = el
            .getAnimations()
            .some((a) => a.playState === "running" || a.playState === "finished");
          if (gaar) continue;

          el.classList.remove("reveal", "reveal-d1", "reveal-d2", "reveal-d3");
          el.classList.add("is-visible");
          el.style.opacity = "1";
          el.style.transform = "none";
        }
      }

      window.addEventListener("load", () => {
        // To bilder: rett etter load, og etter at eventuelle
        // entry-animasjoner har hatt tid til å fullføre.
        setTimeout(tvingSynlig, 400);
        window.addEventListener("scroll", () => setTimeout(tvingSynlig, 600), {
          once: true,
          passive: true,
        });
      });
    </script>

    <script>
      // .scrolled på header etter 40 px.
      const nav = document.querySelector<HTMLElement>(".nav");
      if (nav) {
        let ticking = false;
        const oppdater = () => {
          nav.classList.toggle("scrolled", window.scrollY > 40);
          ticking = false;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(oppdater);
          },
          { passive: true }
        );
        oppdater();
      }
    </script>
  </body>
</html>
