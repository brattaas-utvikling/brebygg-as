---
// src/layouts/BaseLayout.astro
// HTML-skallet for brebygg.no.
// Alle andre layouts wrapper dette.
//
// Props:
//   meta        — tittel, beskrivelse, canonical, ogImage (fra PageMeta)
//   schema      — ferdig JSON-LD-objekt (fra lib/seo/jsonld.ts)
//   heroImage   — URL til hero-bilde for LCP-preload (valgfritt)
//   bodyClass   — ekstra klasser på <body> (valgfritt)

import type { PageMeta } from "@config/site";
import { SEO_DEFAULTS, NAP } from "@config/site";
import { resolveMeta } from "@lib/seo/meta";
import JsonLd from "@components/seo/JsonLd.astro";
import "@styles/globals.css";

// --------------------------------------------------------------------------
// Props
// --------------------------------------------------------------------------

interface Props {
  meta: PageMeta;
  schema: Record<string, unknown>;
  heroImage?: string;
  bodyClass?: string;
}

const { meta, schema, heroImage, bodyClass = "" } = Astro.props;

const resolved = resolveMeta(meta);

const ogImageAbsolute = resolved.ogImage.startsWith("http")
  ? resolved.ogImage
  : `https://brebygg.no${resolved.ogImage}`;

const canonicalUrl = resolved.canonical.startsWith("http")
  ? resolved.canonical
  : `https://brebygg.no${resolved.canonical}`;

const googleFontsUrl =
  "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap";
---

<!doctype html>
<html lang="nb" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolved.title}</title>
    <meta name="description" content={resolved.description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="nb-NO" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    {
      resolved.noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large"
        />
      )
    }

    <meta
      property="og:type"
      content={resolved.pageType === "article" ? "article" : "website"}
    />
    <meta property="og:title" content={resolved.title} />
    <meta property="og:description" content={resolved.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${NAP.name} — Totalentreprenør i Vestfold`}
    />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content={NAP.name} />

    <meta name="twitter:card" content={SEO_DEFAULTS.twitterCard} />
    <meta name="twitter:title" content={resolved.title} />
    <meta name="twitter:description" content={resolved.description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2C4251" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={googleFontsUrl} />
    <link
      rel="stylesheet"
      href={googleFontsUrl}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={googleFontsUrl} />
    </noscript>

    {
      heroImage && (
        <link
          rel="preload"
          as="image"
          href={heroImage}
          fetchpriority="high"
          type="image/webp"
        />
      )
    }

    <JsonLd schema={schema} />
    <slot name="head" />
  </head>

  <body class={`antialiased ${bodyClass}`}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only
        focus:fixed focus:top-4 focus:left-4 focus:z-[200]
        focus:px-4 focus:py-2
        focus:bg-[var(--color-primary)] focus:text-white
        focus:rounded-md focus:font-semibold focus:text-sm
        focus:shadow-lg"
    >
      Hopp til innhold
    </a>

    <slot />

    <!-- ----------------------------------------------------------------
         SCROLL REVEAL
         CSS animation-timeline: view() der det støttes.
         Intersection Observer som fallback (Safari < 17.2, Firefox < 110).
         ---------------------------------------------------------------- -->
    <script>
      (function () {
        "use strict";

        const supportsScrollTimeline =
          typeof CSS !== "undefined" &&
          CSS.supports("animation-timeline", "view()");

        if (supportsScrollTimeline) return;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -48px 0px" }
        );

        document
          .querySelectorAll(".reveal, .reveal-d1, .reveal-d2, .reveal-d3")
          .forEach(function (el) {
            observer.observe(el);
          });
      })();
    </script>

    <!-- ----------------------------------------------------------------
         NAV SCROLL-KLASSE
         Legger til .scrolled på .nav etter 40px scroll.
         ---------------------------------------------------------------- -->
    <script>
      (function () {
        "use strict";

        const nav = document.querySelector<HTMLElement>(".nav");
        if (!nav) return;

        let lastKnown = 0;
        let ticking = false;

        function update(): void {
          nav!.classList.toggle("scrolled", lastKnown > 40);
          ticking = false;
        }

        window.addEventListener(
          "scroll",
          function () {
            lastKnown = window.scrollY;
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );

        update();
      })();
    </script>

    <!-- ----------------------------------------------------------------
         HAMBURGER-MENY
         Toggler .is-open på .nav__links, låser body-scroll.
         ---------------------------------------------------------------- -->
    <script>
      (function () {
        "use strict";

        const burger = document.querySelector<HTMLElement>(".nav-burger");
        const links = document.querySelector<HTMLElement>(".nav__links");

        if (!burger || !links) return;

        function openMenu(): void {
          links!.classList.add("is-open");
          burger!.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
        }

        function closeMenu(): void {
          links!.classList.remove("is-open");
          burger!.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        }

        burger.addEventListener("click", function () {
          links!.classList.contains("is-open") ? closeMenu() : openMenu();
        });

        links.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", function (e: MouseEvent) {
          const nav = document.querySelector<HTMLElement>(".nav");
          if (nav && !nav.contains(e.target as Node | null)) {
            closeMenu();
          }
        });

        document.addEventListener("keydown", function (e: KeyboardEvent) {
          if (e.key === "Escape") closeMenu();
        });
      })();
    </script>

    <!-- ----------------------------------------------------------------
         PROGRESS BAR
         Animerer .progress-bar__fill til data-width ved innrulling.
         ---------------------------------------------------------------- -->
    <script>
      (function () {
        "use strict";

        const bars = document.querySelectorAll<HTMLElement>(
          ".progress-bar__fill[data-width]"
        );
        if (!bars.length) return;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const width = el.getAttribute("data-width") ?? "0";
                el.style.width = width + "%";
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.3 }
        );

        bars.forEach(function (bar) {
          bar.style.width = "0";
          observer.observe(bar);
        });
      })();
    </script>

    <!-- ----------------------------------------------------------------
         DRAG-SCROLL KARUSELL
         Aktiverer musebasert drag på .karusell-elementer.
         ---------------------------------------------------------------- -->
    <script>
      (function () {
        "use strict";

        document
          .querySelectorAll<HTMLElement>(".karusell")
          .forEach(function (el) {
            let isDown = false;
            let startX = 0;
            let scrollX = 0;

            el.addEventListener("mousedown", function (e: MouseEvent) {
              isDown = true;
              startX = e.pageX - el.offsetLeft;
              scrollX = el.scrollLeft;
              el.classList.add("is-dragging");
            });

            document.addEventListener("mouseup", function () {
              isDown = false;
              el.classList.remove("is-dragging");
            });

            el.addEventListener("mousemove", function (e: MouseEvent) {
              if (!isDown) return;
              e.preventDefault();
              const x = e.pageX - el.offsetLeft;
              const walk = (x - startX) * 1.5;
              el.scrollLeft = scrollX - walk;
            });
          });
      })();
    </script>
  </body>
</html>

