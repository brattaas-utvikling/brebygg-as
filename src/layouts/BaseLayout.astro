---
// src/layouts/BaseLayout.astro
// HTML-skallet for brebygg.no.
//
// Endringer fra v1:
//   - Den utkommenterte duplikaten av hele filen er slettet. Den var 8,5 KB og
//     ble sendt til nettleseren på hver eneste sidelast — Astro fjerner ikke
//     HTML-kommentarer. Målt før: 23,8 % av forsidens HTML var kommentarer.
//   - Fontlasting flyttet til <Font /> fra astro:assets. Fjerner to preconnect,
//     preload-as-style, media="print"-hacken, den inline onload-handleren (som
//     ville blokkert enhver CSP) og <noscript>-duplikaten.
//   - De fem inline-skriptene er redusert til to. Progress-bar og karusell-drag
//     hørte hjemme i komponentene som bruker dem — de lastet på /kontakt/ også.
//   - Skip-link bruker .skip-link fra globals.css i stedet for en Tailwind-kjede.
//   - PageMeta bærer nå pageType og noindex, så og:type="article" kan faktisk
//     settes på prosjektsidene.

import type { PageMeta } from "@config/site";
import { SEO_DEFAULTS, NAP, SITE_URL } from "@config/site";
import { resolveMeta, absoluteUrl } from "@lib/seo/meta";
import JsonLd from "@components/seo/JsonLd.astro";
import { Font } from "astro:assets";
import "@styles/globals.css";

interface Props {
  meta:       PageMeta;
  schema:     Record<string, unknown>;
  /** URL til LCP-bildet. Preloades med høy prioritet. */
  heroImage?: string;
  bodyClass?: string;
}

const { meta, schema, heroImage, bodyClass = "" } = Astro.props;

const resolved     = resolveMeta(meta);
const canonicalUrl = absoluteUrl(resolved.canonical);
const ogImageUrl   = absoluteUrl(resolved.ogImage);
---

<!doctype html>
<html lang="nb" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolved.title}</title>
    <meta name="description" content={resolved.description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="nb-NO" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    {resolved.noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

    <meta property="og:type"         content={resolved.pageType === "article" ? "article" : "website"} />
    <meta property="og:title"        content={resolved.title} />
    <meta property="og:description"  content={resolved.description} />
    <meta property="og:url"          content={canonicalUrl} />
    <meta property="og:image"        content={ogImageUrl} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={`${NAP.name} — totalentreprenør i Vestfold`} />
    <meta property="og:locale"       content={SEO_DEFAULTS.locale} />
    <meta property="og:site_name"    content={NAP.name} />

    <meta name="twitter:card"        content={SEO_DEFAULTS.twitterCard} />
    <meta name="twitter:title"       content={resolved.title} />
    <meta name="twitter:description" content={resolved.description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon"  href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2C4251" />

    {/* Selvhostet Plus Jakarta Sans. Astro genererer @font-face, preload for
        den kritiske vekten og en metrisk justert fallback. */}
    <Font cssVariable="--font-jakarta" preload />

    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <JsonLd schema={schema} />
    <slot name="head" />
  </head>

  <body class={`antialiased ${bodyClass}`}>
    <a href="#main-content" class="skip-link">Hopp til innhold</a>

    <slot />

    <script>
      // Scroll-reveal.
      // Bruker animation-timeline: view() der nettleseren støtter det, og faller
      // tilbake til IntersectionObserver ellers.
      if (!(typeof CSS !== "undefined" && CSS.supports("animation-timeline", "view()"))) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -48px 0px" }
        );

        document
          .querySelectorAll(".reveal, .reveal-d1, .reveal-d2, .reveal-d3")
          .forEach((el) => observer.observe(el));
      }
    </script>

    <script>
      // .scrolled på header etter 40 px.
      const nav = document.querySelector<HTMLElement>(".nav");
      if (nav) {
        let ticking = false;
        const oppdater = () => {
          nav.classList.toggle("scrolled", window.scrollY > 40);
          ticking = false;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(oppdater);
          },
          { passive: true }
        );
        oppdater();
      }
    </script>
  </body>
</html>
