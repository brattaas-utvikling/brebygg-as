---
// src/pages/index.astro
// Landingssiden.
//
// Rekkefølgen på seksjonene er ikke lenger hardkodet her — klienten setter dem
// sammen i Sanity og drar dem i den rekkefølgen hun vil. Denne filen eier bare
// to ting: heroen, og at seksjonslista rendres etter den.
//
// Heroen ligger utenfor seksjonslista med vilje. Hero-bildet er LCP-elementet
// og preloades med fetchpriority="high", og <h1> må være første overskrift på
// siden. Kunne klienten flytte heroen ned, ryker begge deler. Alt innholdet i
// heroen er redigerbart — bare ikke plasseringen.

import PageLayout   from "@layouts/PageLayout.astro";
import Hero         from "@components/sections/Hero.astro";
import Seksjoner    from "@components/forside/Seksjoner.astro";
import { PAGE_META, type PageMeta } from "@config/site";
import { getHomeSchema } from "@lib/seo/jsonld";
import { hentForside, faqPaaSiden } from "@lib/sanity/forside";
import { bildeSrc } from "@/content.config";

const forside = await hentForside();

// FAQPage-schema utledes av komposisjonen, ikke av en fast liste. Står ingen
// faqBlokk på siden, legges det ikke ut FAQ-schema — schema for innhold
// brukeren ikke ser er nettopp det Googles retningslinjer slår ned på.
const schema = getHomeSchema(faqPaaSiden(forside.seksjoner));

const meta: PageMeta = {
  ...PAGE_META.home,
  title:       forside.seo?.tittel      ?? PAGE_META.home.title,
  description: forside.seo?.beskrivelse ?? PAGE_META.home.description,
  noindex:     forside.seo?.skjulFraSok ?? false,
};

const heroBilde = forside.hero.bilde
  ? bildeSrc(forside.hero.bilde as never)
  : "/images/hero-forside.webp";
---

<PageLayout meta={meta} schema={schema} heroImage={heroBilde}>
  <main id="main-content">
    <Hero
      tittel={forside.hero.tittel}
      ingress={forside.hero.ingress}
      bilde={forside.hero.bilde}
      knapper={forside.hero.knapper}
    />

    <Seksjoner seksjoner={forside.seksjoner} />
  </main>
</PageLayout>
