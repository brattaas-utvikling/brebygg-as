---
// src/pages/index.astro
// Landingssiden for brebygg.no
//
// Seksjonsrekkefølge (fra spec):
//   1. Header (i PageLayout)
//   2. Hero
//   3. StatsRow
//   4. OngoingBanner
//   5. TjenesterBento
//   6. ProsjektKarusell
//   7. OmOssTeaser
//   8. BaerekraftSeksjon
//   9. CtaSeksjon
//  10. Footer (i PageLayout)

import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/sections/Hero.astro";
// import StatsRow from "@components/sections/StatsRow.astro";
import OngoingBanner from "@components/sections/OngoingBanner.astro";
import TjenesterBento from "@components/sections/TjenesterBento.astro";
import ProsjektKarusell from "@components/sections/ProsjektKarusell.astro";
import OmOssTeaser from "@components/sections/OmOssTeaser.astro";
import BaerekraftSeksjon from "@components/sections/BaerekraftSeksjon.astro";
import CtaSeksjon from "@components/sections/CtaSeksjon.astro";

import { PAGE_META, FAQ_ITEMS } from "@config/site";
import { getHomeSchema } from "@lib/seo/jsonld";

// Schema: LocalBusiness + WebSite + FAQPage
const schema = getHomeSchema(FAQ_ITEMS);
---

<PageLayout
  meta={PAGE_META.home}
  schema={schema}
  heroImage="/images/hero-forside.webp"
>
  <main id="main-content">
    <!-- 2. Hero — fullscreen, LCP-kritisk -->
    <Hero />

    <!-- 3. Stats-rad — 4 nøkkeltall i hvit seksjon -->
    <!-- <StatsRow /> -->

    <!-- 4. Pågående-banner — viser ett aktivt prosjekt -->
    <!--
      Oppdater disse verdiene når et nytt prosjekt starter:
        projectName: navn på bygget
        location:    sted i Vestfold
        progress:    0–100 (%)
        dueLabel:    "Q3 2025" e.l.
    -->
    <OngoingBanner
      projectName="Boligprosjekt"
      location="Sandefjord"
      progress={65}
      dueLabel="Q3 2025"
    />

    <!-- 5. Tjenester — bento-grid på mørk bakgrunn -->
    <TjenesterBento />

    <!-- 6. Prosjektkarusell — drag-scroll, fra content collection -->
    <ProsjektKarusell />

    <!-- 7. Om oss teaser — split-layout på grå bakgrunn -->
    <OmOssTeaser />

    <!-- 8. Bærekraft — blueprint-seksjon på mørk bakgrunn -->
    <BaerekraftSeksjon />

    <!-- 9. CTA — kontaktoppfordring, mørk variant -->
    <CtaSeksjon variant="dark" />
  </main>
</PageLayout>
