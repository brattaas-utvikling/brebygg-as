---
// src/pages/prosjekter/index.astro
// Prosjektoversikten for brebygg.no
//
// Seksjonsrekkefølge (fra spec):
//   1. Header      (i PageLayout)
//   2. HeroPage    — mørk page-header med eyebrow + H1
//   4. ProsjektGalleri (Astro + ~1 KB vanilla, ingen hydrering)
//   6. Footer      (i PageLayout)
//
// Datahåndtering:
//   - getCollection('prosjekter') kjøres på byggetidspunkt
//   - Data serialiseres til ProsjektKortData[] og sendes som props til React
//   - Ingen runtime-fetching — React-islen mottar rene JS-objekter
//
// Filtrering:
//   - URL-parameter: /prosjekter/?kategori=nybygg
//   - React-islen leser og skriver URLSearchParams uten reload

import PageLayout from "@layouts/PageLayout.astro";
import HeroPage from "@components/sections/HeroPage.astro";
import ProsjektGalleri from "@components/prosjekter/ProsjektGalleri.astro";
import { getCollection } from "astro:content";

import { PAGE_META } from "@config/site";
import { getProsjekterSchema } from "@lib/seo/jsonld";

// --------------------------------------------------------------------------
// Data — hentes og serialiseres på byggetidspunkt
// --------------------------------------------------------------------------

const schema = getProsjekterSchema(PAGE_META.prosjekter.canonical);

// Hent alle prosjekter
const alleRaw = await getCollection("prosjekter");

// Sorter: fremhevede øverst → pågående → nyeste år → sortOrder
const sorterte = [...alleRaw].sort((a, b) => {
  // 1. Fremhevede opp
  if (a.data.fremhevet && !b.data.fremhevet) return -1;
  if (!a.data.fremhevet && b.data.fremhevet) return 1;
  // 2. Pågående over ferdig
  if (a.data.status === "pagaende" && b.data.status !== "pagaende") return -1;
  if (a.data.status !== "pagaende" && b.data.status === "pagaende") return 1;
  // 3. Eksplisitt sortOrder
  const soA = a.data.sortOrder ?? 999;
  const soB = b.data.sortOrder ?? 999;
  if (soA !== soB) return soA - soB;
  // 4. Nyeste år
  return b.data.aar - a.data.aar;
});

// v1 serialiserte hvert prosjekt til et flatt objekt for å sende det over
// islands-grensen til React. Med Astro-komponenten er det unødvendig — vi
// sender CollectionEntry-ene direkte, og sparer både koden og JS-en.

---

<PageLayout meta={PAGE_META.prosjekter} schema={schema}>
  <main id="main-content">
    {/* 2. Page-hero — mørk header */}
    <HeroPage
      nesteTema="lys"
      heading="Prosjekter<br />i Vestfold"
      lead="Vi viser hva vi tok på oss, hva som var krevende og hva vi faktisk leverte. Ingen prosjekter er identiske — men arbeidsmåten er den samme."
      imgSrc="/images/prosjekter-hero.webp"
      imgAlt="Byggeplass i Vestfold med kran og stålkonstruksjon"
      imgWidth={800}
      imgHeight={960}
    />

    {/* 4. Prosjektgalleri — ren Astro, ~1 KB vanilla JS.
         Alle kort ligger alltid i DOM; filtrering skjer med hidden.
         Uten JS: alle prosjekter vises, filterlinja skjules. */}
    <ProsjektGalleri prosjekter={sorterte} />

  </main>
</PageLayout>
