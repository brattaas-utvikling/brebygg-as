---
// src/pages/tjenester/[slug].astro
//
// Tjenestesider. Fjerner de tre 404-lenkene som har stått i footeren på hver
// eneste side, og gir samtidig de naturlige landingssidene for «totalentreprenør
// Tønsberg» og «rehabilitering Vestfold».
//
// Intern lenking er halve poenget: hver tjeneste peker på relaterte prosjekter,
// og hvert prosjekt får en vei tilbake til tjenesten sin. Uten det henger
// prosjektsidene i løse lufta, som de har gjort til nå.

import { getCollection, render, type CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Breadcrumbs from "@components/seo/Breadcrumbs.astro";
import CtaSeksjon from "@components/sections/CtaSeksjon.astro";
import { SITE_URL, NAP, HOVEDKOMMUNER, type PageMeta } from "@config/site";
import { getTjenesteSchema } from "@lib/seo/jsonld";
import { KATEGORI_LABEL, bildeSrc } from "@/content.config";
import Bilde from "@components/sanity/Bilde.astro";
import RikTekst from "@components/ui/RikTekst.astro";

export async function getStaticPaths() {
  const tjenester = await getCollection("tjenester");
  const prosjekter = await getCollection("prosjekter");

  return tjenester
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
    .map((entry) => {
      // Valider relaterteProsjekter mot faktiske slugger ved bygg. Zod kan ikke
      // gjøre dette — den kjenner ikke de andre collection-ene. En feilstavet
      // slug ville ellers blitt en stille tom liste i produksjon.
      const treff = entry.data.relaterteProsjekter.map((slug) => {
        const p = prosjekter.find((x) => x.id === slug);
        if (!p) {
          throw new Error(
            `[tjenester/${entry.id}] relaterteProsjekter viser til "${slug}", ` +
              `som ikke finnes i prosjekter-collection. ` +
              `Tilgjengelige: ${prosjekter.map((x) => x.id).join(", ")}`
          );
        }
        return p;
      });

      return {
        params: { slug: entry.id },
        props: { entry, relaterte: treff },
      };
    });
}

interface Props {
  entry: CollectionEntry<"tjenester">;
  relaterte: CollectionEntry<"prosjekter">[];
}

const { entry, relaterte } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Seksjonsoverskrifter og avslutning kan overstyres per tjeneste i Studio.
// Tomt felt gir standardteksten under.
const kort = data.kortTittel ?? data.title;
const o = data.overskrifter ?? {};
const tekster = {
  inkludert: o.inkludert || "Hva du får når vi tar totalentreprisen",
  prosess:   o.prosess   || "Fra første befaring til overlevering",
  relaterte: o.relaterte || `${kort} vi har levert`,
  faq:       o.faq       || `Om ${kort.toLowerCase()}`,
  ctaOverskrift: data.cta?.overskrift || `Skal du bygge i ${HOVEDKOMMUNER.slice(0, 3).join(", ")} eller Horten?`,
  ctaTekst:      data.cta?.tekst      || "Ring for en uforpliktende befaring. Vi sier fra med én gang hvis vi ikke er riktig entreprenør for jobben.",
};

const canonicalPath = `/tjenester/${entry.id}/`;
const canonical = `${SITE_URL}${canonicalPath}`;

const pageMeta: PageMeta = {
  title: data.seoTitle ?? `${data.title} | ${NAP.name}`,
  description: data.seoDescription ?? data.description,
  canonical,
  ogImage: `${SITE_URL}${bildeSrc(data.heroImage)}`,
};

const schema = getTjenesteSchema(
  {
    navn: data.title,
    beskrivelse: data.description,
    canonical,
    kategori: KATEGORI_LABEL[data.kategori],
  },
  [
    { label: "Hjem", url: `${SITE_URL}/` },
    { label: "Tjenester", url: `${SITE_URL}/tjenester/` },
    { label: data.title, url: canonical },
  ],
  data.faq.map((f) => ({ question: f.sporsmaal, answer: f.svar }))
);

// Sammensatte ord i ett, med binde-s der det trengs. Før ble teksten bygd som
// «${kategori}-prosjekter», som ga «rehabilitering-prosjekter».
const PROSJEKTORD: Record<string, string> = {
  nybygg: "nybyggprosjekter",
  rehabilitering: "rehabiliteringsprosjekter",
};
---

<PageLayout
  meta={pageMeta}
  schema={schema}
  heroImage={bildeSrc(data.heroImage)}
>
  <main id="main-content">
    {/* Hero */}
    <section class="tjeneste-hero fjellkant" aria-labelledby="tjeneste-tittel">
      <div class="tjeneste-hero__bg" aria-hidden="true">
        <Bilde
          kilde={data.heroImage}
          alt=""
          prioritet
          fyll
          bredde={1600}
          hoyde={900}
        />
      </div>

      <div class="tjeneste-hero__innhold">
        <div class="container">
          <Breadcrumbs
            customPath={canonicalPath}
            labels={{ [entry.id]: data.title }}
            variant="inv"
          />
          <h1 class="tjeneste-hero__tittel" id="tjeneste-tittel">
            {data.title}
          </h1>
          <p class="tjeneste-hero__ingress">{data.ingress}</p>

          <div class="tjeneste-hero__knapper">
            <a href={NAP.phoneHref} class="btn btn--primary">
              Ring {NAP.phoneDisplay}
            </a>
            {/* Samme sekundærknapp som forsidens hero: kantlinje og pil.
                Var btn--ghost-inv, en klasse uten CSS, så knappen så ut som
                en tekstlenke. */}
            <a
              href={`/prosjekter/?kategori=${data.kategori}`}
              class="btn btn--outline-inv"
            >
              Se {PROSJEKTORD[data.kategori] ?? "prosjektene"}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Brødtekst. Egen seksjon og ikke en kolonne ved siden av «Hva du får»:
        Nybygg har 14 blokker med tre H2-er, altså en hel artikkel, og den ble
        for trang i en halv kolonne. Sanity-teksten har forrang; markdown-
        reserven rendres med render() som før. */}
    <section class="section sek--hvit" aria-label={`Om ${kort.toLowerCase()}`}>
      <div class="container">
        {data.brodtekst
          ? <RikTekst verdi={data.brodtekst} class="tjeneste-prosa" />
          : <div class="rik-tekst tjeneste-prosa"><Content /></div>}
      </div>
    </section>

    {/* Hva som inngår */}
    <section class="section sek--lys" aria-labelledby="inkludert-tittel">
      <div class="container">
        <div>
          <h2 class="section-title mt-2" id="inkludert-tittel">{tekster.inkludert}</h2>
          <ul class="tjeneste-liste tjeneste-liste--bred reveal">
            {
              data.inkludert.map((punkt) => (
                <li class="tjeneste-liste__item">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    class="flex-shrink-0"
                  >
                    <path
                      d="M3.5 8.5L6.5 11.5L12.5 4.5"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{punkt}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* Prosess */}
    <section class="section sek--seksjon" aria-labelledby="prosess-tittel">
      <div class="container">
        <h2 class="section-title mt-2" id="prosess-tittel">{tekster.prosess}</h2>

        <ol class="tjeneste-prosess reveal">
          {
            data.prosess.map((steg, i) => (
              <li class="tjeneste-prosess__steg">
                <span class="tjeneste-prosess__nr" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="tjeneste-prosess__tittel">{steg.tittel}</h3>
                <p class="tjeneste-prosess__tekst">{steg.tekst}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* Relaterte prosjekter */}
    {
      relaterte.length > 0 && (
        <section class="section sek--hvit" aria-labelledby="relaterte-tittel">
          <div class="container">
            <div class="tjeneste-toprad">
              <div>
                <h2 class="section-title mt-2" id="relaterte-tittel">{tekster.relaterte}</h2>
              </div>
              <a
                href={`/prosjekter/?kategori=${data.kategori}`}
                class="btn btn--outline btn--sm"
              >
                Alle prosjekter
              </a>
            </div>

            <div class="tjeneste-relaterte reveal" role="list">
              {relaterte.map((p) => (
                <a
                  href={`/prosjekter/${p.id}/`}
                  class="prosjekt-card"
                  role="listitem"
                >
                  <div class="prosjekt-card__img">
                    <Bilde
                      kilde={p.data.heroImage}
                      alt={p.data.heroImage.alt}
                      bredde={800}
                      hoyde={500}
                      fyll
                      sizes="(max-width: 639px) 100vw, 420px"
                    />
                  </div>
                  <div class="prosjekt-card__body">
                    <span class="prosjekt-card__tag">
                      {KATEGORI_LABEL[p.data.kategori]}
                    </span>
                    <h3 class="prosjekt-card__title">{p.data.title}</h3>
                    <p class="prosjekt-card__meta">
                      {p.data.location}
                      <span aria-hidden="true"> · </span>
                      {p.data.aar}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* FAQ */}
    {
      data.faq.length > 0 && (
        <section class="section sek--seksjon" aria-labelledby="faq-tittel">
          <div class="container tjeneste-faq">
            <h2 class="section-title mt-2" id="faq-tittel">{tekster.faq}</h2>

            <div class="tjeneste-faq__liste reveal">
              {data.faq.map((f) => (
                <details class="tjeneste-faq__item">
                  <summary class="tjeneste-faq__sporsmaal">
                    {f.sporsmaal}
                  </summary>
                  <p class="tjeneste-faq__svar">{f.svar}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <CtaSeksjon variant="dark" heading={tekster.ctaOverskrift} sub={tekster.ctaTekst} />
  </main>
</PageLayout>
