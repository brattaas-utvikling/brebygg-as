---
// src/pages/om-oss.astro
// Om oss-siden for brebygg.no
//
// Seksjonsrekkefølge (fra spec):
//   1. Header   (i PageLayout)
//   2. HeroPage — split: tekst venstre + bilde høyre, sitat, stats
//   3. HistorieSeksjon — vertikal tidslinje
//   4. TeamSeksjon — portrettkort med navn og rolle
//   5. VerdierSeksjon — 4 verdier på mørk bakgrunn
//   6. HmsSeksjon — HMS-punkter + sertifiserings-badges
//   8. Footer   (i PageLayout)

import PageLayout from "@layouts/PageLayout.astro";
import HeroPage from "@components/sections/HeroPage.astro";
import TeamSeksjon from "@components/sections/TeamSeksjon.astro";
import VerdierSeksjon from "@components/sections/VerdierSeksjon.astro";
import HmsSeksjon from "@components/sections/HmsSeksjon.astro";

import { PAGE_META, FAKTA_BEKREFTET } from "@config/site";
import { getOmOssSchema } from "@lib/seo/jsonld";

const schema = getOmOssSchema(PAGE_META.omOss.canonical);

// Sitat fra daglig leder (oppdater tekst og kilde)
const sitat =
  "Vi lever av anbefalinger. Det er det ærligste kvalitetsbeviset vi kan ha.";
const sitatKilde = "Rudi, BRE Bygg AS";
---

<PageLayout
  meta={PAGE_META.omOss}
  schema={schema}
  heroImage="/images/om-oss-hero.webp"
>
  <main id="main-content">
    {/* 2. HeroPage — split-hero */}
    <HeroPage
      nesteTema="hvit"
      heading="Totalentreprenør<br />i Vestfold og Telemark"
      lead={`BRE Bygg er ${FAKTA_BEKREFTET.ansatte} personer med base i Sandefjord. Vi leverer nybygg, rehabilitering og næringsbygg i Tønsberg, Sandefjord, Larvik og Horten — som totalentreprenør, med én prosjektleder på hvert oppdrag.`}
      sitat={sitat}
      sitatKilde={sitatKilde}
      imgSrc="/images/om-oss-hero.webp"
      imgAlt="BRE Bygg-team på byggeplass i Vestfold"
      imgWidth={800}
      imgHeight={960}
      imgFade={true}
    />

    <TeamSeksjon />

    <VerdierSeksjon />

    <HmsSeksjon />
  </main>
</PageLayout>
