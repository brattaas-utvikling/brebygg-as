---
// src/pages/om-oss.astro
// Om oss-siden for brebygg.no
//
// All tekst og alle bilder redigeres i Studio under Sider → Om oss.
// Personene i teamslideren redigeres under Personer.
//
// Seksjonsrekkefølge:
//   1. Header   (i PageLayout)
//   2. HeroPage — split: tekst venstre + bilde høyre, sitat
//   3. TeamSeksjon — portrettslider
//   4. VerdierSeksjon — verdier på mørk bakgrunn
//   5. HmsSeksjon — HMS-punkter
//   6. Tilleggsseksjoner fra Studio (valgfritt)
//   7. Footer   (i PageLayout)

import PageLayout from "@layouts/PageLayout.astro";
import HeroPage from "@components/sections/HeroPage.astro";
import TeamSeksjon from "@components/sections/TeamSeksjon.astro";
import VerdierSeksjon from "@components/sections/VerdierSeksjon.astro";
import HmsSeksjon from "@components/sections/HmsSeksjon.astro";
import Seksjoner from "@components/forside/Seksjoner.astro";

import { PAGE_META, FAKTA_BEKREFTET } from "@config/site";
import { getOmOssSchema } from "@lib/seo/jsonld";
import { hentOmOssSide, medSeo, heroPreloadBilde, SIDEHERO_SIZES } from "@lib/sanity/sider";

const side = await hentOmOssSide(FAKTA_BEKREFTET.ansatte);
const meta = medSeo(PAGE_META.omOss, side.seo);
const schema = getOmOssSchema(PAGE_META.omOss.canonical);
---

<PageLayout
  meta={meta}
  schema={schema}
  heroImage={heroPreloadBilde(side.hero.bilde)}
  heroSizes={SIDEHERO_SIZES}
>
  <main id="main-content">
    <HeroPage
      heading={side.hero.tittel}
      lead={side.hero.ingress}
      sitat={side.hero.sitat}
      sitatKilde={side.hero.sitatKilde}
      bilde={side.hero.bilde}
    />

    <TeamSeksjon overskrift={side.team.overskrift} tekst={side.team.tekst} />

    <VerdierSeksjon {...side.verdier} />

    <HmsSeksjon {...side.hms} />

    <Seksjoner seksjoner={side.seksjoner} />
  </main>
</PageLayout>
