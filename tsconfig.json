{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": {
      "@/*":           ["./src/*"],
      "@config/*":     ["./src/config/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*":    ["./src/layouts/*"],
      "@lib/*":        ["./src/lib/*"],
      "@styles/*":     ["./src/styles/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.mjs", "*.ts"],
  "exclude": ["node_modules", "dist", ".vercel"]
}
