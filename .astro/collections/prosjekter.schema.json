{
  "$ref": "#/definitions/prosjekter",
  "definitions": {
    "prosjekter": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 30,
          "maxLength": 200
        },
        "location": {
          "type": "string"
        },
        "kategori": {
          "type": "string",
          "enum": [
            "nybygg",
            "rehabilitering",
            "naeringsbygg"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ferdig",
            "pagaende"
          ],
          "default": "ferdig"
        },
        "aar": {
          "type": "integer",
          "minimum": 2007,
          "maximum": 2030
        },
        "varighet": {
          "type": "string"
        },
        "heroImage": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "galleri": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "utfordring": {
          "type": "string"
        },
        "losning": {
          "type": "string"
        },
        "resultat": {
          "type": "string"
        },
        "nokkeltall": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "verdi": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "verdi"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "klient": {
          "type": "string"
        },
        "seoTitle": {
          "type": "string",
          "maxLength": 60
        },
        "seoDescription": {
          "type": "string",
          "maxLength": 160
        },
        "fremhevet": {
          "type": "boolean",
          "default": false
        },
        "sortOrder": {
          "type": "number"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "kategori",
        "aar",
        "heroImage"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}