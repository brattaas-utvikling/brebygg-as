# .env.example
# Kopier til .env og fyll inn. .env skal ALDRI committes.

# ---------------------------------------------------------------------------
# Sanity
#
# Uten PUBLIC_SANITY_PROJECT_ID bygger nettstedet fra markdown-filene i
# src/content/. Sett den, og bygget henter fra Sanity i stedet. Det er
# kildebryteren — se kommentaren i src/content.config.ts.
# ---------------------------------------------------------------------------

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Kun nødvendig hvis datasettet er privat, eller for å lese utkast i
# forhåndsvisning. Leses kun ved bygg og havner aldri i klientbundelen.
# Lag den under Manage → API → Tokens med rollen Viewer.
SANITY_API_READ_TOKEN=

# Kun for scripts/migrer-innhold.ts. Rolle: Editor.
# Kan overskrive hele innholdsbiblioteket — tøm verdien når migreringen er
# ferdig, og legg den ALDRI inn i Vercel. Bygget skal ikke kunne skrive.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Kart (valgfritt)
#
# Uten nøkkel brukes den nøkkelløse q=-formen i src/config/site.ts. Den
# fungerer, men er udokumentert. Med nøkkel kan MAPS.embedUrl byttes til
# Google Maps Embed API.
# ---------------------------------------------------------------------------

PUBLIC_MAPS_EMBED_KEY=
